r\n257: </body>\r\n258: </html>`;\r\n259: }\r\n260: \r\n261: function renderFailMd(data, enriched) {\r\n262:   const { failures } = enriched;\r\n263:   let md = `# Fail list — ${data.appEnv || 'QA'}\\n\\n`;\r\n264:   md += `Run: ${data.run || '-'} · baseU\n<truncated 64 bytes>\nilures.length}\\n\\n`;\r\n266:   for (const f of failures) {\r\n267:     md += `## ${f.route} — ${f.scenario}\\n\\n`;\r\n268:     md += `- feature: ${f.feature}\\n- tc: ${f.tc || '-'}\\n- status: ${f.status}\\n- duration: ${durationLabel(f.durationMs)}\\n\\n`;\r\n269:     if (f.digest) md += `**${f.digest}**\\n\\n`;\r\n270:     if (f.errorPreview) md += '```text\\n' + f.errorPreview + '\\n```\\n\\n';\r\n271:   }\r\n272:   return md;\r\n273: }\r\n274: \r\n275: function main() {\r\n276:   const { jsonPath, noOpen } = parseArgs(process.argv.slice(2));\r\n277:   const { data, base } = loadReport(jsonPath);\r\n278:   const enriched = enrich(data);\r\n279: \r\n280:   const html = renderHtml(data, enriched);\r\n281:   const ts = timestamp();\r\n282:   fs.mkdirSync(REPORTS, { recursive: true });\r\n283:   const htmlTs = path.join(REPORTS, `${base}-report-${ts}.html`);\r\n284:   const htmlLatest = path.join(REPORTS, `${base}-report-latest.html`);\r\n285:   fs.writeFileSync(htmlLatest, html, 'utf8');\r\n286:   fs.writeFileSync(htmlTs, html, 'utf8');\r\n287: \r\n288:   const md = renderFailMd(data, enriched);\r\n289:   const mdPath = path.join(REPORTS, `fail-list-${base}.md`);\r\n290:   fs.writeFileSync(mdPath, md, 'utf8');\r\n291: \r\n292:   const jsonOut = path.join(REPORTS, `fail-list-${base}.json`);\r\n293:   fs.writeFileSync(\r\n294:     jsonOut,\r\n295:     JSON.stringify({ appEnv: data.appEnv, summary: data.summary, failures: enriched.failures }, null, 2),\r\n296:     'utf8',\r\n297:   );\r\n298: \r\n299:   console.log(`HTML report : ${htmlLatest}`);\r\n300:   console.log(`Fail list   : ${mdPath}`);\r\n301:   console.log(\r\n302:     `Total: ${data.summary?.total ?? 0}  Pass: ${data.summary?.passed ?? 0}  Fail: ${data.summary?.failed ?? 0}  Skip: ${data.summary?.skipped ?? 0}`,\r\n303:   );\r\n304: \r\n305:   if (!noOpen) {\r\n306:     console.log(`\\nOpen manually: ${htmlLatest}`);\r\n307:   }\r\n308: }\r\n309: \r\n310: main();\r\n311: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

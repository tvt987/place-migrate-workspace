tent = await mod.ui.content().isVisible().catch(() => false);\n122:     expect(!onIds && (content || err || (resp?.status() ?? 0) >= 400), 'list shell/error/4xx, không IDS').toBeTruthy();\n123:   });\n124: });\n125: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}

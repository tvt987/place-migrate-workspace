{"step_index":8486,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-12T04:55:24Z","content":"Created At: 2026-10-12T11:55:24+07:00\nCompleted At: 2026-10-12T11:55:24+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-scm-web/03_qa/scripts/start-env.win.ps1`\nTotal Lines: 127\nTotal Bytes: 5817\nShowing lines 75 to 127\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n75: Write-Host \"API PID=$($apiProc.Id)\"\r\n76: \r\n77: # Start web.\r\n78: $env:ASPNETCORE_URLS = \"http://0.0.0.0:$WebPort\"\r\n79: $env:ASPNETCORE_ENVIRONMENT = \"Development\"\r\n80: $webProc = Start-Process -FilePath \"dotnet\" -ArgumentList \"run\", \"--no-launch-profile\" `\r\n81:     -WorkingDirectory $WebDir -PassThru -WindowStyle Hidden `\r\n82:     -RedirectStandardOutput $WebLog -RedirectStandardError \"$WebLog.err\"\r\n83: $webProc.Id | Out-File -FilePath $WebPidFile -Encoding ascii\r\n84: Write-Host \"WEB PID=$($webProc.Id)\"\r\n85: \r\n86: # Wait for health (API swagger 200-499 + WEB 200-499) — max ~3 min (90 x 2s).\r\n87: #\r\n88: # ROOT CAUSE của timeout hay gặp (2026-09-29, confirmed bằng đo trực tiếp): \"localhost\" resolve ra\r\n89: # CẢ ::1 (IPv6, AAAA) lẫn 127.0.0.1 (IPv4, A) trên Windows — Invoke-WebRequest thử IPv6 trước, mất\r\n90: # ~2.5s mới fallback IPv4 (API/WEB chỉ bind 0.0.0.0 = IPv4, không có gì lắng nghe ::1 → hoặc\r\n91: # firewall silently drop SYN, không RST nhanh). -TimeoutSec 2 bên dưới LUÔN bị cắt giữa lúc đang\r\n92: # chờ IPv6 timeout, không bao giờ kịp thấy app đã ready qua IPv4 — app thực ra trả 200 trong\r\n93: # <0.1s qua 127.0.0.1 (đã verify bằng curl trực tiếp). Dùng 127.0.0.1 thẳng, không qua DNS/hosts,\r\n94: # né hoàn toàn độ trễ IPv6 — không phải tăng -TimeoutSec (đó là né triệu chứng, không sửa nguyên\r\n95: # nhân).\r\n96: function Get-HttpStatus($url) {\r\n97:     try {\r\n98:         $resp = Invoke-WebRequest -Uri $url -TimeoutSec 2 -UseBasicParsing -ErrorAction Stop\r\n99:         return [int]$resp.StatusCode\r\n100:     } catch {\r\n101:         if ($_.Exception.Response) { return [int]$_.Exception.Response.StatusCode }\r\n102:         return 0\r\n103:     }\r\n104: }\r\n105: \r\n106: $ready = $false\r\n107: for ($i = 1; $i -le 90; $i++) {\r\n108:     $a = Get-HttpStatus \"http://127.0.0.1:$ApiPort/swagger/v1/swagger.json\"\r\n109:     $w = Get-HttpStatus \"http://127.0.0.1:$WebPort/\"\r\n110:     if ($a -ge 200 -and $a -lt 500 -and $w -ge 200 -and $w -lt 500) {\r\n111:         Write-Host \"✅ Env ready (API=$a, WEB=$w)\"\r\n112:         $ready = $true\r\n113:         break\r\n114:     }\r\n115:     Start-Sleep -Seconds 2\r\n116: }\r\n117: \r\n118: if (-not $ready) {\r\n119:     Write-Host \"❌ Env failed to start (API=$a, WEB=$w)\"\r\n120:     Write-Host \"--- API log ---\"\r\n121:     if (Test-Path $ApiLog) { Get-Content $ApiLog -Tail 20 }\r\n122:     Write-Host \"--- WEB log ---\"\r\n123:     if (Test-Path $WebLog) { Get-Content $WebLog -Tail 20 }\r\n124:     exit 1\r\n125: }\r\n126: exit 0\r\n127: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

\n    {\n        public static void Main(string[] args)\n        {\n            var host = CreateHostBuilder(args).Build();\n\n            // legacy helpers resolve through the Engine.ContainerManager service locator (ApiHelper, UserPrincipal, LogActionFilter...) so it must wrap the Autofac root after Build. The flat script assigned it too, but AFTER ClientPermissionWorker had been started against a null ContainerManager\n            Engine.ContainerManager = new ContainerManager((IContainer)host.Services.GetAutofacRoot());\n\n            // Config/StartupSubcribeMessageFromRedis.cs was a real, complete implementation (memory-cache clear + permission reload on Redis pub/sub) that NOTHING called after the OWIN Startup went away. Redis being down must never block app start (same guard as mbm-web/hrm-web Program.cs)\n            try\n            {\n                Startup.SubcribeMessageFromRedis();\n            }\n            catch (Exception ex)\n            {\n                Console.Error.WriteLine($\"[Redis] pub/sub subscribe failed at startup (continuing without it): {ex.GetBaseException().Message}\");\n            }\n\n            host.Run();\n        }\n\n        public static IHostBuilder CreateHostBuilder(string[] args)\n        {\n            // cci.core.json holds JWT/Redis/Logger/Oauth2/OutputCache/SessionRedis config that CCI.Core.MVC's HostBuilderItem binds internally; optional:false because AppConfig/Core assume it exists (same contract as the other gold apps). appsettings.json (AppSettings/CommonConfig/URLConnectionConfig read by Config/AppConfig.cs) is loaded by Host.CreateDefaultBuilder\n            return Host.CreateDefaultBuilder(args)\n                .ConfigureAppConfiguration((context, config) =>\n                {\n                    config.AddJsonFile(\"cci.core.json\", optional: false, reloadOnChange: true);\n                })\n                .UseServiceProviderFactory(new AutofacServiceProviderFactory())\n                .ConfigureWebHostDefaults(webHostBuilder =>\n                {\n                    webHostBuilder\n                        .UseContentRoot(Directory.GetCurrentDirectory())\n                        .UseStartup<Startup>();\n                });\n        }\n    }\n}\n//AI[MIGRATE_END]\n\n"}

{"step_index":3367,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-01T03:44:37Z","content":"Created At: 2026-10-01T10:44:37+07:00\nCompleted At: 2026-10-01T10:44:37+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-store-location-api/03_qa/scripts/upload-report.js`\nTotal Lines: 156\nTotal Bytes: 7311\nShowing lines 100 to 156\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n100:   return data.length;\r\n101: }\r\n102: \r\n103: async function record(fileName, appEnv, gcsUrl) {\r\n104:   const { TESTREPORTER_DB_HOST: host, TESTREPORTER_DB_NAME: database } = process.env;\r\n105:   const { TESTREPORTER_DB_USER: user, TESTREPORTER_DB_PASSWORD: password } = process.env;\r\n106:   if (!host || !database || !user || !password) {\r\n107:     fail('thiếu TESTREPORTER_DB_HOST / _NAME / _USER / _PASSWORD trong .env');\r\n108:   }\r\n109:   const client = new Client({\r\n110:     host,\r\n111:     port: Number(process.env.TESTREPORTER_DB_PORT || 5432),\r\n112:     database,\r\n113:     user,\r\n114:     password,\r\n115:     connectionTimeoutMillis: 10000,\r\n116:     // pg_hba chỉ nhận kết nối mã hoá. Như sslmode=require của libpq: mã hoá, không verify cert\r\n117:     // (server dùng cert tự ký). TESTREPORTER_DB_SSL=disable nếu DB khác không bật SSL.\r\n118:     ssl: process.env.TESTREPORTER_DB_SSL === 'disable' ? false : { rejectUnauthorized: false },\r\n119:   });\r\n120:   await client.connect();\r\n121:   try {\r\n122:     const { rows } = await client.query(\r\n123:       `INSERT INTO test_report (project, file_name, app_env, gcs_url)\r\n124:        VALUES ($1, $2, $3, $4)\r\n125:        ON CONFLICT (project, file_name)\r\n126:        DO UPDATE SET app_env = EXCLUDED.app_env, gcs_url = EXCLUDED.gcs_url, created_at = now()\r\n127:        RETURNING test_report_id`,\r\n128:       [PROJECT, fileName, appEnv, gcsUrl],\r\n129:     );\r\n130:     return rows[0].test_report_id;\r\n131:   } finally {\r\n132:     await client.end();\r\n133:   }\r\n134: }\r\n135: \r\n136: async function main() {\r\n137:   const file = resolveFile(process.argv.slice(2));\r\n138:   if (!fs.existsSync(file)) fail(`không thấy file ${file}`);\r\n139:   const fileName = path.basename(file);\r\n140:   const appEnv = readAppEnv(file);\r\n141: \r\n142:   console.log(`→ upload-report: ${fileName} (${PROJECT}, ${appEnv ?? 'APP_ENV?'})`);\r\n143:   const signed = await presign(fileName, loadToken());\r\n144:   const bytes = await put(file, signed);\r\n145:   console.log(`  GCS  : ${signed.AbsoluteURL} (${(bytes / 1048576).toFixed(1)} MB)`);\r\n146:   const id = await record(fileName, appEnv, signed.AbsoluteURL);\r\n147:   console.log(`  DB   : test_report_id=${id}`);\r\n148: }\r\n149: \r\n150: // fetch của Node chỉ báo \"fetch failed\" — lý do thật (DNS, TLS, ECONNREFUSED…) nằm ở e.cause.\r\n151: main().catch((e) => {\r\n152:   const cause = e.cause && (e.cause.code || e.cause.message);\r\n153:   console.error(`upload-report: ${e.message || e}${cause ? `: ${cause}` : ''}`);\r\n154:   process.exitCode = 1;\r\n155: });\r\n156: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

{"step_index":4793,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-02T04:33:39Z","content":"Created At: 2026-10-02T11:33:39+07:00\nCompleted At: 2026-10-02T11:33:39+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-dc-web/03_qa/fixtures/auth.fixture.ts`\nTotal Lines: 66\nTotal Bytes: 3069\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { test as setup, expect } from '@playwright/test';\r\n2: import { getBaseUrl, getUsername, getPassword } from '../utils/env-helper';\r\n3: \r\n4: // SSO login → save cookie storageState for the e2e project.\r\n5: // Hỗ trợ CẢ 2 IDS:\r\n6: //   - IdentityServer cũ (local/dev): input[name=\"username\"] · input[name=\"password\"] · #btnLogin\r\n7: //   - Keycloak (UAT: ids1-uat.concung.vn/realms/master/protocol/openid-connect/auth):\r\n8: //     cùng input username/password, nút submit là input[name=\"login\"].\r\n9: \r\n10: setup('authenticate via SSO', async ({ page }) => {\r\n11:   setup.setTimeout(120_000); // SSO qua Keycloak + trang chủ stg có thể chậm hơn 30s mặc định\r\n12:   const username = getUsername();\r\n13:   const password = getPassword();\r\n14:   if (!username || !password) {\r\n15:     throw new Error('TEST_USERNAME and TEST_PASSWORD must be set in .env (see .env.example)');\r\n16:   }\r\n17: \r\n18:   const appOrigin = new URL(getBaseUrl()).origin;\r\n19:   await page.goto(getBaseUrl(), { waitUntil: 'domcontentloaded', timeout: 60000 });\r\n20: \r\n21:   // App → redirect to IDS login. Phát hiện trang login bằng EITHER:\r\n22:   //   - known login path (IdentityServer cũ), OR\r\n23:   //   - bị redirect ra khỏi app origin (Keycloak UAT — URL ids1-uat.../openid-connect/auth\r\n24:   //     KHÔNG khớp pattern /identity|/Account/Login|/connect/authorize cũ).\r\n25:   const onLoginPage = await page\r\n26:     .waitForURL(\r\n27:       (u) =>\r\n28:         u.origin !== appOrigin ||\r\n29:         /\\/identity|\\/Account\\/Login|\\/connect\\/authorize/i.test(u.href),\r\n30:       { timeout: 15000 },\r\n31:     )\r\n32:     .then(() => true)\r\n33:     .catch(() => false);\r\n34: \r\n35:   if (onLoginPage) {\r\n36:     const usernameInput = page.locator('input[name=\"username\"]').first();\r\n37:     const passwordInput = page.locator('input[name=\"password\"]').first();\r\n38:     // IdentityServer cũ: #btnLogin. Keycloak (UAT): input[name=\"login\"].\r\n39:     const submitButton = page.locator('#btnLogin, input[name=\"login\"]').first();\r\n40: \r\n41:     await usernameInput.fill(username);\r\n42:     await passwordInput.fill(password);\r\n43:     // waitUntil 'commit': chỉ cần URL đã về app — trang chủ nặng (vd income: hàng trăm cửa hàng)\r\n44:     // có thể chưa bắn 'load' trong 30s timeout của test dù đăng nhập đã xong (gặp 2026-10-01).\r\n45:     const backToApp = () =>\r\n46:       page.waitForURL((u) => u.origin === appOrigin, { timeout: 60000, waitUntil: 'commit' });\r\n47:     await Promise.all([\r\n48:       backToApp().catch((e: Error) => {\r\n49:         // Chuỗi 302 callback có thể huỷ 1 navigation (ERR_ABORTED / frame detached) dù cuối cùng\r\n50:         // vẫn về app — chờ lại thay vì fail ngay.\r\n51:         if (/ERR_ABORTED|frame was detached/i.test(e.message)) return backToApp();\r\n52:         throw e;\r\n53:       }),\r\n54:       submitButton.click(),\r\n55:     ]);\r\n56:   }\r\n57: \r\n58:   // Landed back on the app (authenticated) — không còn ở IDS/login (kể cả Keycloak host).\r\n59:   await expect(page).not.toHaveURL(\r\n60:     (u) => u.origin !== appOrigin || /\\/identity|\\/Account\\/Login/i.test(u.href),\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

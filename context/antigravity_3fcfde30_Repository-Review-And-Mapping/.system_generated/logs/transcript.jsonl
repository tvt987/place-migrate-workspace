{"step_index":18112,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-15T02:06:48Z","content":"Created At: 2026-10-15T09:06:48+07:00\nCompleted At: 2026-10-15T09:06:48+07:00\nFile Path: `file:///E:/Work/Place_Migrate/cci-scm-web/03_qa/scripts/upload-report.js`\nTotal Lines: 160\nTotal Bytes: 6277\nShowing lines 61 to 120\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n61: \n62: async function presign(objectName, token, env, fetchImpl) {\n63:   const gcsApi = env.TESTREPORTER_GCS_API || 'https://wap-gcs-api-stg.concung.vn/api/gcs/public/getpresignedlink';\n64:   const moduleName = env.TESTREPORTER_GCS_MODULE || 'none';\n65:   const url = `${gcsApi}?fileName=${encodeURIComponent(objectName)}&module=${encodeURIComponent(moduleName)}`;\n66:   const response = await fetchImpl(url, {\n67:     headers: { accept: 'text/plain', Authorization: `Bearer ${token}` },\n68:   });\n69:   const text = await response.text();\n70:   if (!response.ok) fail(`presign request failed with HTTP ${response.status}: ${text.slice(0, 300)}`);\n71:   const signed = JSON.parse(text);\n72:   if (!signed.PreSignedURL || !signed.AbsoluteURL) fail(`presign response missing fields: ${text.slice(0, 300)}`);\n73:   return signed;\n74: }\n75: \n76: async function put(file, signed, fileSystem, fetchImpl) {\n77:   const data = fileSystem.readFileSync(file);\n78:   const response = await fetchImpl(signed.PreSignedURL, {\n79:     method: 'PUT',\n80:     headers: { 'Content-Type': signed.ContentType || 'application/json' },\n81:     body: data,\n82:   });\n83:   if (!response.ok) fail(`GCS PUT failed with HTTP ${response.status}: ${(await response.text()).slice(0, 300)}`);\n84:   return data.length;\n85: }\n86: \n87: async function record(params, env, createClient) {\n88:   const { TESTREPORTER_DB_HOST: host, TESTREPORTER_DB_NAME: database } = env;\n89:   const { TESTREPORTER_DB_USER: user, TESTREPORTER_DB_PASSWORD: password } = env;\n90:   if (!host || !database || !user || !password) {\n91:     fail('missing TESTREPORTER_DB_HOST / _NAME / _USER / _PASSWORD in .env');\n92:   }\n93:   const client = createClient({\n94:     host,\n95:     port: Number(env.TESTREPORTER_DB_PORT || 5432),\n96:     database,\n97:     user,\n98:     password,\n99:     connectionTimeoutMillis: 10000,\n100:     ssl: env.TESTREPORTER_DB_SSL === 'disable' ? false : { rejectUnauthorized: false },\n101:   });\n102:   await client.connect();\n103:   try {\n104:     const result = await client.query(\n105:       `INSERT INTO test_report\n106:         (project, platform, file_name, app_env, test_machine, gcs_url)\n107:        VALUES ($1, $2, $3, $4, $5, $6)\n108:        ON CONFLICT (project, platform, file_name)\n109:        DO UPDATE SET app_env = EXCLUDED.app_env,\n110:                      test_machine = EXCLUDED.test_machine,\n111:                      gcs_url = EXCLUDED.gcs_url,\n112:                      created_at = now()\n113:        RETURNING test_report_id`,\n114:       buildUpsertParams(params),\n115:     );\n116:     return result.rows[0].test_report_id;\n117:   } finally {\n118:     await client.end();\n119:   }\n120: }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

{"step_index":1770,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-09-29T10:44:33Z","content":"Created At: 2026-09-29T17:44:33+07:00\nCompleted At: 2026-09-29T17:44:33+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-store-location-web/tests/scripts/run-tests.sh`\nTotal Lines: 180\nTotal Bytes: 7547\nShowing lines 1 to 180\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/bin/bash\n2: # Runs the four test tracks of store-location-web and writes tests/reports/test-report-YYYYMMDD-HHMMSS.md\n3: # from the real `dotnet test` output.\n4: #\n5: #   Unit        - no network (Moq over IApiHelper, compat converters, session store, auth filter)\n6: #   Integration - real ids1-uat Keycloak + MDM Permissions/ReadClient over HTTP\n7: #   Functional  - real host: every [MvcAuthorize] action anonymously + SSO-backed contracts\n8: #   Smoke       - real host + SSO session: every page / read-only Ajax endpoint answers 200\n9: #\n10: # Every track is BUILT first (Functional references the web project, and building it while the host runs\n11: # would hit locked DLLs), then Unit + Integration run, then the web host starts on $PLACE_WEB_PORT\n12: # (default 4784 = port of the registered Keycloak redirect_uri) for Functional + Smoke and is stopped after.\n13: # SSO credentials: PLACE_WEB_SSO_USERNAME / PLACE_WEB_SSO_PASSWORD or tests/.env (see tests/.env.example).\n14: set -u\n15: export PATH=\"/usr/bin:/bin:$PATH\"\n16: \n17: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n18: TESTS_DIR=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n19: APP_ROOT=\"$(cd \"$TESTS_DIR/..\" && pwd)\"\n20: WEB_DIR=\"$APP_ROOT/02_target/CoC.Web.Place\"\n21: REPORTS_DIR=\"$TESTS_DIR/reports\"\n22: PORT=\"${PLACE_WEB_PORT:-4784}\"\n23: export PLACE_WEB_BASE_URL=\"${PLACE_WEB_BASE_URL:-http://localhost:$PORT}\"\n24: \n25: # Functional/Smoke/Integration assert the UAT contract (ids1-uat, client place-uat.concung.vn, localhost:4784).\n26: # app.config at the app root is STAGING by workspace conventio\n<truncated 4797 bytes>\n_BASE_URL (Functional/Smoke)\"\n127:   echo \"\"\n128:   echo \"## Results\"\n129:   echo \"\"\n130:   echo \"| Track | Status | Passed | Failed | Skipped | Total | Duration |\"\n131:   echo \"|-------|--------|--------|--------|---------|-------|----------|\"\n132:   for t in $TRACKS; do\n133:     failed=$(get_result \"$t\" failed \"-\"); total=$(get_result \"$t\" total \"0\")\n134:     if [ -f \"$WORK/$t.buildfail\" ] || [ \"$total\" = \"0\" ] || [ \"$failed\" != \"0\" ]; then status=\"❌\"; else status=\"✅\"; fi\n135:     echo \"| $t | $status | $(get_result \"$t\" passed 0) | $failed | $(get_result \"$t\" skipped 0) | $total | $(get_result \"$t\" duration -) |\"\n136:   done\n137:   any_fail=0\n138:   for t in $TRACKS; do\n139:     if [ -s \"$WORK/$t.fails\" ] || [ -f \"$WORK/$t.buildfail\" ]; then any_fail=1; fi\n140:   done\n141:   if [ $any_fail -eq 1 ]; then\n142:     echo \"\"\n143:     echo \"## Failed Tests\"\n144:     for t in $TRACKS; do\n145:       if [ -s \"$WORK/$t.fails\" ] || [ -f \"$WORK/$t.buildfail\" ]; then\n146:         echo \"\"\n147:         echo \"### $t\"\n148:         echo \"\"\n149:         [ -f \"$WORK/$t.buildfail\" ] && sed 's/^/- BUILD: /' \"$WORK/$t.buildfail\"\n150:         [ -s \"$WORK/$t.fails\" ] && cat \"$WORK/$t.fails\"\n151:       fi\n152:     done\n153:   fi\n154:   if [ -n \"$HOST_NOTE\" ]; then\n155:     echo \"\"\n156:     echo \"## Host\"\n157:     echo \"\"\n158:     echo \"$HOST_NOTE\"\n159:     echo '```'\n160:     tail -n 30 \"$HOST_LOG\" 2>/dev/null\n161:     echo '```'\n162:   fi\n163:   echo \"\"\n164:   echo \"## Build Warnings\"\n165:   echo \"\"\n166:   echo \"| Track | Warnings |\"\n167:   echo \"|-------|----------|\"\n168:   for t in $TRACKS; do echo \"| $t | $(get_result \"$t\" warnings 0) |\"; done\n169: } > \"$REPORT\"\n170: \n171: for t in $TRACKS; do\n172:   if [ -f \"$WORK/$t.buildfail\" ] || [ \"$(get_result \"$t\" total 0)\" = \"0\" ] || [ \"$(get_result \"$t\" failed 1)\" != \"0\" ]; then OVERALL=1; fi\n173: done\n174: \n175: echo \"\"\n176: cat \"$REPORT\"\n177: echo \"\"\n178: echo \"Report: $REPORT\"\n179: exit $OVERALL\n180: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}

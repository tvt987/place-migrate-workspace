net4.get('total')}, Passed={s_net4.get('passed')}, Failed={s_net4.get('failed')}, Skipped={s_net4.get('skipped')}\\\")\\n    print(f\\\"MSSQL (Target STG10): Total={s_mssql.get('total')}, Passed={s_mssql.get('passed')}, Failed={s_mssql.get('failed')}, Skipped={s_mssql.get('skipped')}\\\")\\n    print()\\n\\n    regressions = []\\n    origin_fails = []\\n    improvements = []\\n    both_passed = []\\n    both_skipped = []\\n\\n    all_keys = set(t_net4.keys()).union(set(t_mssql.keys()))\\n\\n    for k in sorted(all_keys):\\n        n4 = t_net4.get(k)\\n        m10 = t_mssql.get(k)\\n\\n       \n<truncated 1945 bytes>","Description":"\"Script to compare test results between NET4 and NET10 mssql\"","Overwrite":"true","TargetFile":"\"C:\\\\Users\\\\25303_TruongVanTinh\\\\.gemini\\\\antigravity-ide\\\\brain\\\\3fcfde30-4110-403c-8f9f-a4ed95abc9e6\\\\scratch\\\\compare_reports.py\"","toolAction":"\"Writing comparison script\"","toolSummary":"\"Write compare_reports.py\""}}],"truncated_fields":["tool_calls"]}

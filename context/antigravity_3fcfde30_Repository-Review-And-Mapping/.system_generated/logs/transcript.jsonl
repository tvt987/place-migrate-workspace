ing]$UrlVar = \"NET10_MSSQL_BASE_URL\",\r\n27:     [ValidateSet(\"mssql\", \"pgsql\")]\r\n28:     [string]$LocalVariant = \"mssql\"\r\n29: )\r\n30: \r\n31: $ErrorActionPreference = \"Stop\"\r\n32: $scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path\r\n33: \r\n34: function Get-EnvValue([string]$key) {\r\n35:     $envFile = Join-Path $scriptDir \"..\\.env\"\r\n36:     if (-not (Test-Path $envFile)) { return \"\" }\r\n37:     $line = Get-Content $envFile | Where-Object { $_ -match \"^$key=\" } | Select-Object -First 1\r\n38:     if (-not $line) { return \"\" }\r\n39:     # Cắt \"/\" cuối (giống dc-api Makefile) — spec nối BASE + \"/...\" sẽ thành \"//\".\r\n40:     return ($line -replace \"^$key=\", \"\").Trim().TrimEnd('/')\r\n41: }\r\n42: \r\n43: # -Variant auto: biến $UrlVar trong .env (cùng tên với dc-api/03_qa/.env) quyết định local hay\r\n44: # remote — đổi đích test bằng cách sửa .env, KHÔNG cần đổi lệnh gõ. Rỗng/thiếu hoặc trỏ localhost\r\n45: # -> tự build+start API+WEB ($LocalVariant) trên máy, test ở :5311. URL remote -> trỏ thẳng, không\r\n46: # start gì cục bộ.\r\n47: if ($Variant -eq \"auto\") {\r\n48:     if ($BaseUrl -eq \"\") { $BaseUrl = Get-EnvValue $UrlVar }\r\n49:     if ($BaseUrl -ne \"\" -and $BaseUrl -notmatch '^https?://(localhost|127\\.0\\.0\\.1)(:|/|$)') {\r\n50:         $Variant = \"none\"\r\n51:     } else {\r\n52:         $BaseUrl = \"\"\r\n53:         $Variant = $LocalVariant\r\n54:     }\r\n55: }\r\n56: \r\n57: $ports = @{ mssql = 5311; pgsql = 5311 }\r\n58: \r\n59: if ($Variant -ne \"none\") {\r\n60:     & powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path $scriptDir \"start-env.win.ps1\") -Variant $Variant\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

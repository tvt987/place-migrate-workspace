{"step_index":18186,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-15T02:10:06Z","content":"Created At: 2026-10-15T09:10:06+07:00\nCompleted At: 2026-10-15T09:10:06+07:00\nFile Path: `file:///E:/Work/Place_Migrate/cci-scm-web/03_qa/scripts/upload-report.js`\nTotal Lines: 160\nTotal Bytes: 6277\nShowing lines 61 to 160\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n61: \n62: async function presign(objectName, token, env, fetchImpl) {\n63:   const gcsApi = env.TESTREPORTER_GCS_API || 'https://wap-gcs-api-stg.concung.vn/api/gcs/public/getpresignedlink';\n64:   const moduleName = env.TESTREPORTER_GCS_MODULE || 'none';\n65:   const url = `${gcsApi}?fileName=${encodeURIComponent(objectName)}&module=${encodeURIComponent(moduleName)}`;\n66:   const response = await fetchImpl(url, {\n67:     headers: { accept: 'text/plain', Authorization: `Bearer ${token}` },\n68:   });\n69:   const text = await response.text();\n70:   if (!response.ok) fail(`presign request failed with HTTP ${response.status}: ${text.slice(0, 300)}`);\n71:   const signed = JSON.parse(text);\n72:   if (!signed.PreSignedURL || !signed.AbsoluteURL) fail(`presign response missing fields: ${text.slice(0, 300)}`);\n73:   return signed;\n74: }\n75: \n76: async function put(file, signed, fileSystem, fetchImpl) {\n77:   const data = fileSystem.readFileSync(file);\n78:   const response = await fetchImpl(signed.PreSignedURL, {\n79:     method: 'PUT',\n80:     headers: { 'Content-Type': signed.ContentType || 'application/json' },\n81:     body: data,\n82:   });\n83:   if (!response.ok) fail(`GCS PUT failed with HTTP ${response.status}: ${(await response.text()).slice(0, 300)}`);\n84:   return data.length;\n85: }\n86: \n87: async function record(params, env, createClient) {\n88:   const { TESTREPORTER_DB_HOST: host, TESTREPORTER_DB_NAME: database } = env;\n89:   const { TESTREPORTER_DB_USER: user, TESTREPORTER_DB_PASSWORD: password } = env;\n90:   if (!host || !database || !user || !password) {\n91: \n<truncated 1115 bytes>\nync function main(argv = process.argv.slice(2), dependencies = {}) {\n123:   const fileSystem = dependencies.fs || fs;\n124:   const env = dependencies.env || process.env;\n125:   const fetchImpl = dependencies.fetch || fetch;\n126:   const dryRun = argv[0] === '--dry-run';\n127:   const file = resolveFile(dryRun ? argv.slice(1) : argv, fileSystem);\n128:   if (!fileSystem.existsSync(file)) fail(`report file not found: ${file}`);\n129:   const report = parseReport(file, fileSystem);\n130:   const project = env.TESTREPORTER_PROJECT || '1_MBM';\n131:   const fileName = path.basename(file);\n132:   const objectName = buildObjectName(project, fileName);\n133: \n134:   if (dryRun) {\n135:     console.log(`object=${objectName} platform=${PLATFORM} testMachine=${report.testMachine}`);\n136:     return;\n137:   }\n138: \n139:   const signed = await presign(objectName, loadToken(fileSystem), env, fetchImpl);\n140:   const bytes = await put(file, signed, fileSystem, fetchImpl);\n141:   const createClient = dependencies.createClient || ((config) => new (require('pg').Client)(config));\n142:   const testReportId = await record(\n143:     { project, fileName, appEnv: report.appEnv || null, testMachine: report.testMachine, gcsUrl: signed.AbsoluteURL },\n144:     env,\n145:     createClient,\n146:   );\n147:   console.log(`uploaded ${objectName} (${bytes} bytes), test_report_id=${testReportId}`);\n148: }\n149: \n150: module.exports = { buildObjectName, buildUpsertParams, main, parseReport, resolveFile };\n151: \n152: if (require.main === module) {\n153:   require('dotenv').config({ path: path.join(ROOT, '.env') });\n154:   main().catch((error) => {\n155:     const cause = error.cause && (error.cause.code || error.cause.message);\n156:     console.error(`upload-report: ${error.message || error}${cause ? `: ${cause}` : ''}`);\n157:     process.exitCode = 1;\n158:   });\n159: }\n160: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

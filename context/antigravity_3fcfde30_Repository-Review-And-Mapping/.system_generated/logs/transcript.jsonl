   return value;\r\n36:             LoadDotEnv();\r\n37:             _dotEnv.TryGetValue(key, out value);\r\n38:             if (string.IsNullOrEmpty(value))\r\n39:                 throw new InvalidOperationException(key + \" is not set: export it or add it to tests/.env (template tests/.env.example)\");\r\n40:             return value;\r\n41:         }\r\n42: \r\n43:         private static void LoadDotEnv()\r\n44:         {\r\n45:             if (_dotEnv != null)\r\n46:                 return;\r\n47:             var values = new Dictionary<string, string>(StringComparer.Ordinal);\r\n48:             for (var dir = new DirectoryInfo(AppContext.BaseDirectory); dir != null; dir = dir.Parent)\r\n49:             {\r\n50:                 var file = Path.Combine(dir.FullName, \".env\");\r\n51:                 if (!File.Exists(file))\r\n52:                     continue;\r\n53:                 foreach (var line in File.ReadAllLines(file))\r\n54:                 {\r\n55:                     var trimmed = line.Trim();\r\n56:                     if (trimmed.Length == 0 || trimmed.StartsWith(\"#\"))\r\n57:                         continue;\r\n58:                     var eq = trimmed.IndexOf('=');\r\n59:                     if (eq > 0)\r\n60:                         values[trimmed.Substring(0, eq).Trim()] = trimmed.Substring(eq + 1).Trim();\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

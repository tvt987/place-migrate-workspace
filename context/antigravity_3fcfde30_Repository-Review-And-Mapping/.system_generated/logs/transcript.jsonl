e(/\"/g, '&quot;')\r\n38:     .replace(/'/g, '&#39;');\r\n39: }\r\n40: \r\n41: function truncate(s, n = 500) {\r\n42:   const t = String(s ?? '');\r\n43:   return t.length <= n ? t : t.slice(0, n) + '…';\r\n44: }\r\n45: \r\n46: function digestError(err) {\r\n47:   if (!err) return '';\r\n48:   const first = String(err).split('\\n').find((l) => l.trim()) || '';\r\n49:   return truncate(first.replace(/\\s+/g, ' '), 160);\r\n50: }\r\n51: \r\n52: function durationLabel(ms) {\r\n53:   if (ms == null) return '-';\r\n54:   if (ms < 1000) return `${ms}ms`;\r\n55:   return `${(ms / 1000).toFixed(1)}s`;\r\n56: }\r\n57: \r\n58: function parseArgs(argv) {\r\n59:   const flags = new Set();\r\n60:   const pos = [];\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

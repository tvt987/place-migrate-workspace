{"step_index":4777,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-02T04:32:58Z","content":"Created At: 2026-10-02T11:32:58+07:00\nCompleted At: 2026-10-02T11:32:58+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-dc-web/03_qa/playwright.config.ts`\nTotal Lines: 51\nTotal Bytes: 1799\nShowing lines 1 to 51\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { defineConfig, devices } from '@playwright/test';\r\n2: import { config } from 'dotenv';\r\n3: \r\n4: config();\r\n5: \r\n6: // E2E target = dc-web MVC app (NOT the API). Default port 5311 (net10_mssql local).\r\n7: const baseURL =\r\n8:   process.env.LOCAL_BASE_URL || process.env.BASE_URL || 'http://localhost:5311';\r\n9: \r\n10: // Làm chậm thao tác browser khi chạy --headed để quan sát bằng mắt (ms giữa mỗi action).\r\n11: // Set qua `make test-browser SLOWMO=800`. Không set → 0 (tốc độ bình thường).\r\n12: const slowMo = Number(process.env.SLOWMO) || 0;\r\n13: \r\n14: export default defineConfig({\r\n15:   testDir: './',\r\n16:   timeout: 30000,\r\n17:   retries: 0,\r\n18:   reporter: [['list'], ['allure-playwright'], ['./utils/json-reporter.ts']],\r\n19:   use: {\r\n20:     baseURL,\r\n21:     ignoreHTTPSErrors: true,\r\n22:     launchOptions: { slowMo },\r\n23:     screenshot: 'only-on-failure',\r\n24:     video: 'retain-on-failure',\r\n25:     trace: 'retain-on-failure',\r\n26:   },\r\n27:   projects: [\r\n28:     {\r\n29:       // SSO login → save storageState (cookie) to .auth/state.json.\r\n30:       // Runs ONCE before e2e. Requires TEST_USERNAME + TEST_PASSWORD in .env.\r\n31:       name: 'setup',\r\n32:       testMatch: /fixtures\\/auth\\.fixture\\.ts/,\r\n33:       use: { ...devices['Desktop Chrome'] },\r\n34:     },\r\n35:     {\r\n36:       // Authenticated E2E — reuses cookies from setup (no per-test SSO).\r\n37:       name: 'e2e',\r\n38:       testMatch: /e2e\\/.*\\.e2e\\.spec\\.ts/,\r\n39:       dependencies: ['setup'],\r\n40:       use: { ...devices['Desktop Chrome'], storageState: '.auth/state.json' },\r\n41:     },\r\n42:     {\r\n43:       // Local variant — no setup dependency; assumes app already logged in or\r\n44:       // storageState committed manually. Run with: npm run test:local\r\n45:       name: 'e2e-local',\r\n46:       testMatch: /e2e\\/.*\\.e2e\\.spec\\.ts/,\r\n47:       use: { ...devices['Desktop Chrome'], storageState: '.auth/state.json' },\r\n48:     },\r\n49:   ],\r\n50: });\r\n51: \nThe above content shows the entire, complete file contents of the requested file.\n"}

\n34: \r\n35: GCS_API = os.environ.get(\"TESTREPORTER_GCS_API\", \"https://wap-gcs-api-stg.concung.vn/api/gcs/public/getpresignedlink\")\r\n36: GCS_MODULE = os.environ.get(\"TESTREPORTER_GCS_MODULE\", \"none\")\r\n37: PROJECT = os.environ.get(\"TESTREPORTER_PROJECT\", \"11_DC\")\r\n38: \r\n39: DB_HOST = os.environ.get(\"TESTREPORTER_DB_HOST\")\r\n40: DB_NAME = os.environ.get(\"TESTREPORTER_DB_NAME\")\r\n41: DB_USER = os.environ.get(\"TESTREPORTER_DB_USER\")\r\n42: DB_PASS = os.environ.get(\"TESTREPORTER_DB_PASSWORD\")\r\n43: \r\n44: if not all([DB_HOST, DB_NAME, DB_USER, DB_PASS]):\r\n45:     raise RuntimeError(\r\n46:         \"missing TESTREPORTER_DB_HOST / _NAME / _USER / _PASSWORD - dien vao 03_qa/.env \"\r\n47:         \"(xem .env.example), KHONG hardcode lai trong file nay\"\r\n48:     )\r\n49: \r\n50: def get_token():\r\n51:     if not os.path.exists(AUTH_TOKEN_FILE):\r\n52:         raise RuntimeError(f\"Missing {AUTH_TOKEN_FILE}\")\r\n53:     with open(AUTH_TOKEN_FILE, \"r\", encoding=\"utf-8\") as f:\r\n54:         data = json.load(f)\r\n55:     token = data.get(\"access_token\")\r\n56:     if not token:\r\n57:         raise RuntimeError(\"No access_token found in token.json\")\r\n58:     return token\r\n59: \r\n60: def upload_file(report_file, app_env):\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

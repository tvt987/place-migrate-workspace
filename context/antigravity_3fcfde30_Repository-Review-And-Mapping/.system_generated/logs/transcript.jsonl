portId}`);\n148: }\n149: \n150: module.exports = { buildObjectName, buildUpsertParams, main, parseReport, resolveFile };\n151: \n152: if (require.main === module) {\n153:   require('dotenv').config({ path: path.join(ROOT, '.env') });\n154:   main().catch((error) => {\n155:     const cause = error.cause && (error.cause.code || error.cause.message);\n156:     console.error(`upload-report: ${error.message || error}${cause ? `: ${cause}` : ''}`);\n157:     process.exitCode = 1;\n158:   });\n159: }\n160: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

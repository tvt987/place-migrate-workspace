keyword !== '') {\n39:       const kw = this.ui.keyword();\n40:       if (await kw.count()) {\n41:         await kw.fill(keyword);\n42:       }\n43:     } else if (keyword === '') {\n44:       const kw = this.ui.keyword();\n45:       if (await kw.count()) {\n46:         await kw.fill('');\n47:       }\n48:     }\n49:     const wait = waitForPost(this.page, endpoint, 60000);\n50:     const alertP = this.ui\n51:       .alertText()\n52:       .or(this.ui.alertWarning())\n53:       .waitFor({ state: 'visible', timeout: 12000 })\n54:       .then(() => true)\n55:       .catch(() => false);\n56:     await this.ui.searchButton().click();\n57:     const alerted = await alertP;\n58:     if (alerted) {\n59:       return { response: null, codeStep: null, alerted: true };\n60:     }\n61:     const response = await wait.catch(() => null);\n62:     return { response, codeStep: await readCodeStep(response), alerted: false };\n63:   }\n64: \n65:   async gotoPage2(endpoint: string): Promise<{ response: Response | null; codeStep: ObjCodeStep | null; alerted: boolean }> {\n66:     const wait = waitForPost(this.page, endpoint, 60000);\n67:     const link = this.ui.pagerPage2();\n68:     await link.click();\n69:     const response = await wait.catch(() => null);\n70:     return { response, codeStep: await readCodeStep(response), alerted: false };\n71:   }\n72:   async clickExportExcel(): Promise<void> {\n73:     await this.ui.exportExcelButton().click();\n74:   }\n75: }\n76: \nThe above content shows the entire, complete file contents of the requested file.\n"}

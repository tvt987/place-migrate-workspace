ecursive: true });\r\n28:   writeFileSync(join(dir, 'token.json'), JSON.stringify(data, null, 2), 'utf-8');\r\n29: }\r\n30: \r\n31: setup('authenticate via ids1-Keycloak — issue Bearer token', async ({ page }) => {\r\n32:   await loginIds1(page);\r\n33: });\r\n34: \r\n35: async function loginIds1(page: import('@playwright/test').Page): Promise<void> {\r\n36:   const username = getUsername();\r\n37:   const password = getPassword();\r\n38:   if (!username || !password) {\r\n39:     throw new Error('TEST_USERNAME and TEST_PASSWORD must be set in .env (see .env.example)');\r\n40:   }\r\n41:   const idsUrl = getIds1Url();\r\n42:   const clientId = getIds1ClientId();\r\n43:   const scope = getIds1Scope();\r\n44:   const redirectUri = getIds1RedirectUri();\r\n45: \r\n46:   // The access_token lives in the URL fragment (browser-side only) — but Playwright's\r\n47:   // waitForURL only fires when the redirect navigation COMMITS, which needs *something*\r\n48:   // answering on the redirect port. Serve a stub 200 locally so the flow never depends\r\n49:   // on an API instance or a user-started stub being up (EADDRINUSE = someone already\r\n50:   // answers — e.g. the local store-location-api instance itself on that port — equally fine, ignore it).\r\n51:   const redirectPort = new URL(redirectUri).port || '80';\r\n52:   const { createServer } = await import('http');\r\n53:   const stub = createServer((_req, res) => {\r\n54:     res.writeHead(200, { 'Content-Type': 'text/plain' });\r\n55:     res.end('oauth2-redirect stub (QA harness)');\r\n56:   });\r\n57:   await new Promise<void>((resolve) => {\r\n58:     stub.on('error', () => resolve());\r\n59:     stub.listen(Number(redirectPort), () => resolve());\r\n60:   });\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

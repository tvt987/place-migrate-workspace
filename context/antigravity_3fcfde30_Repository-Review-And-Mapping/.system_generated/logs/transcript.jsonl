{"step_index":8186,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-09T04:54:53Z","content":"Created At: 2026-10-09T11:54:53+07:00\nCompleted At: 2026-10-09T11:54:53+07:00\nFile Path: `file:///C:/Users/25303_TruongVanTinh/.gemini/antigravity-ide/brain/3fcfde30-4110-403c-8f9f-a4ed95abc9e6/scratch/create_scm_prs.py`\nTotal Lines: 59\nTotal Bytes: 2137\nShowing lines 1 to 59\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import subprocess\n2: import urllib.request\n3: import urllib.error\n4: import json\n5: import sys\n6: \n7: def get_token():\n8:     p = subprocess.Popen(['git', 'credential', 'fill'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n9:     out, _ = p.communicate('protocol=https\\nhost=bitbucket.org\\n\\n')\n10:     creds = dict(l.split('=', 1) for l in out.splitlines() if '=' in l)\n11:     return creds.get('password')\n12: \n13: def create_pull_request(repo, src, dest, title, description=\"\"):\n14:     token = get_token()\n15:     url = f'https://api.bitbucket.org/2.0/repositories/{repo}/pullrequests'\n16:     payload = {\n17:         \"title\": title,\n18:         \"description\": description or f\"Merge branch '{src}' into {dest}\",\n19:         \"source\": {\n20:             \"branch\": {\n21:                 \"name\": src\n22:             }\n23:         },\n24:         \"destination\": {\n25:             \"branch\": {\n26:                 \"name\": dest\n27:             }\n28:         },\n29:         \"close_source_branch\": False\n30:     }\n31:     \n32:     data = json.dumps(payload).encode('utf-8')\n33:     req = urllib.request.Request(url, data=data, method='POST')\n34:     req.add_header('Authorization', f'Bearer {token}')\n35:     req.add_header('Content-Type', 'application/json')\n36:     \n37:     try:\n38:         with urllib.request.urlopen(req) as resp:\n39:             res_data = json.loads(resp.read().decode('utf-8'))\n40:             pr_id = res_data.get('id')\n41:             html_url = res_data.get('links', {}).get('html', {}).get('href')\n42:             print(f\"[SUCCESS] Created PR #{pr_id}: {title}\")\n43:             print(f\"  Source: {src} -> Destination: {dest}\")\n44:             print(f\"  URL: {html_url}\")\n45:             return res_data\n46:     except urllib.error.HTTPError as e:\n47:         err_msg = e.read().decode('utf-8')\n48:         print(f\"[ERROR {e.code}] Failed to create PR for {src} -> {dest}:\")\n49:         print(f\"  {err_msg}\")\n50:         return None\n51: \n52: if __name__ == '__main__':\n53:     repo = \"concung/cci-scm-web\"\n54:     print(\"=== Creating PR: dev -> staging10 ===\")\n55:     pr1 = create_pull_request(repo, \"dev\", \"staging10\", \"Merge dev into staging10\")\n56:     \n57:     print(\"\\n=== Creating PR: dev -> staging ===\")\n58:     pr2 = create_pull_request(repo, \"dev\", \"staging\", \"Merge dev into staging\")\n59: \nThe above content shows the entire, complete file contents of the requested file.\n"}

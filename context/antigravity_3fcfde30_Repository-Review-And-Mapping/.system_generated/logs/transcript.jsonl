tch { if (`$_.Exception.Response) { break }; Start-Sleep -Seconds 1 }\r\n379: }\r\n380: Start-Process '$ui'\r\n381: \"@\r\n382: }\r\n383: \r\n384: # --- -Detached: chay nen, doi port len, THOAT 0 va de IIS Express chay tiep --\r\n385: # Danh cho preLaunchTask cua VS Code - xem ghi chu dai o .PARAMETER Detached.\r\n386: if ($Detached) {\r\n387:     $log = Join-Path $env:TEMP \"$LogPrefix-$Port.log\"\r\n388: \r\n389:     # TUYET DOI khong dung Start-Process -RedirectStandardOutput o day. Co -Redirect* thi\r\n390:     # PowerShell chuyen sang UseShellExecute=false, va tien trinh con KE THUA handle stdout\r\n391:     # cua chinh script nay. Hau qua: script `exit 0` roi ma stream van chua dong (iisexpress\r\n392:     # con giu ban sao cua handle), nen ben goi khong bao gio thay EOF - VS Code cho mai\r\n393:     # khong thay task ket thuc va F5 treo o buoc preLaunchTask. Da dinh dung loi nay: script\r\n394:     # xong trong 5 giay ma pipeline treo qua 5 phut.\r\n395:     #\r\n396:     # Cach o day: Start-Process KHONG kem -Redirect* => UseShellExecute=true => con khong\r\n397:     # ke thua stdio cua ta. Van giu duoc log bang cach cho cmd.exe tu redirect. Bo hai dau\r\n398:     # nhay ngoai cung la cu phap bat buoc cua `cmd /c` khi lenh ben trong co duong dan\r\n399:     # dat trong nhay kep.\r\n400:     $quoted  = $iisArgs | ForEach-Object { if ($_ -match '\\s') { '\"' + $_ + '\"' } else { $_ } }\r\n401:     $cmdLine = '\"\"{0}\" {1} > \"{2}\" 2>&1\"' -f $iisExpress, ($quoted -join ' '), $log\r\n402:     $proc    = Start-Process 'cmd.exe' -ArgumentList '/c', $cmdLine -WindowStyle Hidden -PassThru\r\n403: \r\n404:     # Doi bang TCP connect chu khong doc file log: file dang bi iisexpress giu de ghi nen\r\n405:     # doc vao co the dinh sharing violation. Cung khong goi HTTP health: request dau tien\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view 
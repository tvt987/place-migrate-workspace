tem.Collections.Generic;\r\n8: using System.Linq;\r\n9: using System.Reflection;\r\n10: using System.Threading.Tasks;\r\n11: \r\n12: namespace CoC.Web.SCM.ViewComponents\r\n13: {\r\n14:     public cl\n<truncated 3815 bytes>\nvices.GetRequiredService<Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine>();\r\n77:             var found = engine.FindView(actionContext, name, isMainPage: false);\r\n78:             if (!found.Success)\r\n79:                 throw new InvalidOperationException(\"Child action: view '\" + name + \"' not found. Searched: \" + string.Join(\", \", found.SearchedLocations ?? Enumerable.Empty<string>()));\r\n80:             return found.View.Path;\r\n81:         }\r\n82: \r\n83:         private static MethodInfo FindAction(Type controllerType, string action, IDictionary<string, object> values)\r\n84:         {\r\n85:             var candidates = controllerType.GetMethods(BindingFlags.Public | BindingFlags.Instance)\r\n86:                 .Where(m => string.Equals(m.Name, action, StringComparison.OrdinalIgnoreCase) && !m.IsSpecialName && m.DeclaringType != typeof(object))\r\n87:                 .ToList();\r\n88:             if (candidates.Count <= 1) return candidates.FirstOrDefault();\r\n89:             // overloads (GET Index() vs POST Index(Req)): take the one whose parameters are all supplied, most parameters first; else the parameterless one\r\n90:             return candidates\r\n91:                 .Where(m => m.GetParameters().All(p => values.Keys.Any(k => string.Equals(k, p.Name, StringComparison.OrdinalIgnoreCase))))\r\n92:                 .OrderByDescending(m => m.GetParameters().Length)\r\n93:                 .FirstOrDefault();\r\n94:         }\r\n95: \r\n96:         private static object Bind(ParameterInfo p, IDictionary<string, object> values)\r\n97:         {\r\n98:             var key = values.Keys.FirstOrDefault(k => string.Equals(k, p.Name, StringComparison.OrdinalIgnoreCase));\r\n99:             if (key == null)\r\n100:   
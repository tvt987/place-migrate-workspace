# Git Bash chay tu PowerShell chi thua ke PATH cua Windows, KHONG co /usr/bin cua no\n25: # => grep/awk/python3 deu \"command not found\". Phai tu chen vao.\n26: export PATH := $(GIT_ROOT)/usr/bin;$(GIT_ROOT\n<truncated 799 bytes>\nrong repo này (dc-web) lên Bitbucket.\n46: #   make pc        -> git add --all + commit \"push code\" + push\n47: #   make p_c       -> alias của pc\n48: #   make push_code -> alias của pc\n49: #   make status    -> git status --short\n50: pc: push_code\n51: \n52: p_c: push_code\n53: \n54: push_code:\n55: \tgit add --all\n56: \tgit commit -m \"push code\" || true\n57: \tgit push\n58: \n59: status:\n60: \t@git status --short\n61: \t@echo \"--- branch: $$(git branch --show-current) ---\"\n62: \t@git remote get-url origin 2>/dev/null || echo \"no remote\"\n63: \n64: # Pull code gốc (Bitbucket) của project \"dc-web\" (group 11_DC, root.01_origin[] trong\n65: # .meta/00_projects.json, project có name == \"dc-web\") vào 01_origin/ — CHỈ snapshot code,\n66: # KHÔNG khởi tạo git repo / checkout branch nào (01_origin/ là thư mục thường, không có .git\n67: # sau khi pull).\n68: # --depth 1 --single-branch: KHÔNG kéo lịch sử git.\n69: # dest (01_origin/) bị rm -rf TOÀN BỘ trước khi rsync (không chỉ riêng .git) để đảm bảo không\n70: # còn sót git cũ / file rác từ lần pull trước. project_info.json bị xoá theo và được ghi lại\n71: # mới hoàn toàn ngay sau khi rsync xong — vì Makefile này chỉ pull đúng 1 project (dc-web) nên\n72: # không mất dữ liệu log của project khác.\n73: # Pull thành công sẽ được log lại (url, branch, thời điểm pull) vào 01_origin/project_info.json.\n74: # SAU KHI PULL PHẢI `make config` lại: appSetting.config/Web.config (và .pristine) bị xoá theo.\n75: #   make pull_code\n76: # sha cua ban clone tam duoc lay TRUOC khi xoa .git, roi ghi vao project_info.json\n77: # (bitbucket_commit) de truy nguoc snapshot ung voi commit nao cua repo goc.\n78: # Dung cp -a chu KHONG dung rsync: Git Bash tren Windows khong co rsync.\n79: pull_code:\
:WEB_PORT) { $env:WEB_PORT } else { 5316 }\r\n25:     $ApiCsproj = if ($env:API_CSPROJ) { $env:API_CSPROJ } else { \"..\\..\\scm-api\\02_target\\net10_mssql\\Coc.API.SCM\\Coc.API.SCM.csproj\" }\r\n26:     $ApiDir    = if ($env:API_DIR) { $env:API_DIR } else {\n<truncated 577 bytes>\nI=:$ApiPort WEB=:$WebPort\"\r\n38: \r\n39: function Stop-Port($port) {\r\n40:     $conns = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue\r\n41:     foreach ($c in $conns) {\r\n42:         try {\r\n43:             Stop-Process -Id $c.OwningProcess -Force -ErrorAction SilentlyContinue\r\n44:             Write-Host \"Killed port $port (PID $($c.OwningProcess))\"\r\n45:         } catch {}\r\n46:     }\r\n47: }\r\n48: \r\n49: Stop-Port $ApiPort\r\n50: Stop-Port $WebPort\r\n51: \r\n52: # Build (retry 3 times — MSB3492 transient do IDE design-time race).\r\n53: foreach ($csproj in @($ApiCsproj, $WebCsproj)) {\r\n54:     $ok = $false\r\n55:     for ($i = 1; $i -le 3; $i++) {\r\n56:         dotnet build \"$csproj\" -v:q\r\n57:         if ($LASTEXITCODE -eq 0) { $ok = $true; break }\r\n58:         Write-Host \"build retry $i/3: $csproj\"\r\n59:         Start-Sleep -Seconds 3\r\n60:     }\r\n61:     if (-not $ok) {\r\n62:         Write-Host \"❌ Build failed: $csproj\"\r\n63:         exit 1\r\n64:     }\r\n65: }\r\n66: \r\n67: # Start API. Windows PowerShell 5.1's Start-Process has no -Environment param (PS7+ only) —\r\n68: # set env vars on this process so the child (spawned as our child) inherits them instead.\r\n69: $env:ASPNETCORE_URLS = \"http://0.0.0.0:$ApiPort\"\r\n70: $env:ASPNETCORE_ENVIRONMENT = \"Development\"\r\n71: $apiProc = Start-Process -FilePath \"dotnet\" -ArgumentList \"run\", \"--no-launch-profile\" `\r\n72:     -WorkingDirectory $ApiDir -PassThru -WindowStyle Hidden `\r\n73:     -RedirectStandardOutput $ApiLog -RedirectStandardError \"$ApiLog.err\"\r\n74: $apiProc.Id | Out-File -FilePath $ApiPidFile -Encoding ascii\r\n75: Write-Host \"API PID=$($apiProc.Id)\"\r\n76: \r\n77: # Start web.\r\n78: $env:ASPNETCORE_URLS = \"http://0.0.0.0:$WebPort\"\r\n79: $env:ASPNETCORE_ENVIRONMENT = \"Development\"\r\n80: $webProc = Start-Process -FilePath \"dotnet\" -ArgumentList \"run\", \"--no-launch-profile\" `\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

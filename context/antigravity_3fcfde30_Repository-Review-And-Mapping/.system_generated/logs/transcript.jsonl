{"step_index":8990,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-13T06:51:33Z","content":"Created At: 2026-10-13T13:51:33+07:00\nCompleted At: 2026-10-13T13:51:33+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-scm-api/scripts/run-origin.ps1`\nTotal Lines: 522\nTotal Bytes: 27257\nShowing lines 290 to 350\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n290:     #     dong. Can lai so dong thi build `make build_origin ARGS=\"-WindowsPdb\"`.\r\n291:     #   * Rang buoc 64-bit cua \"clr\" nghia la -Use32Bit se lam breakpoint khong bind, du PDB\r\n292:     #     dung dinh dang. Mac dinh cua script la 64-bit nen khong dinh.\r\n293:     # CscToolPath rong: csproj import Microsoft.Net.Compilers 1.0.0 (Roslyn cua VS2015,\r\n294:     # ghim trong packages.config) va props cua goi do tro CscToolPath vao csc trong goi.    # csc doi 1.0 CHUA BIET portable PDB - de nguyen thi build chet ngay:\r\n295:     #   CSC : error CS1902: Invalid option 'portable' for /debug; must be full or pdbonly\r\n296:     # Xoa CscToolPath tren dong lenh la MSBuild quay ve Roslyn hien dai cua chinh no. Da\r\n297:     # kiem chung: build thanh cong, 0 error, va bin/CoC.API.SCM.pdb bat dau bang \"BSJB\"\r\n298:     # (magic cua portable PDB) thay vi \"Microsoft C/C++ MSF\".\r\n299:     $debugTypeArg = @()\r\n300:     if ($Configuration -eq 'Debug' -and -not $WindowsPdb) {\r\n301:         $debugTypeArg = @('/p:DebugType=portable', '/p:CscToolPath=', '/p:CscToolExe=csc.exe')\r\n302:         Write-Ok 'DebugType=portable + Roslyn cua MSBuild (de VS Code dat duoc breakpoint).'\r\n303:     }\r\n304: \r\n305:     Write-Step \"Build ($Configuration | Any CPU)\"\r\n306:     & $msbuild $Solution `\r\n307:         /t:Build `\r\n308:         /p:Configuration=$Configuration `\r\n309:         /p:Platform=\"Any CPU\" `\r\n310:         @debugTypeArg `\r\n311:         /m `\r\n312:         /v:minimal `\r\n313:         /nologo `\r\n314:         /consoleloggerparameters:ErrorsOnly`;Summary\r\n315:     if ($LASTEXITCODE -ne 0) { Die \"Build that bai (exit $LASTEXITCODE).\" }\r\n316:     Write-Ok 'Build thanh cong.'\r\n317: }\r\n318: \r\n319: # --- Pipeline ---------------------------------------------------------------\r\n320: # Script nay KHONG bom config. Viec do chi thuoc ve `make config` (scripts/apply-env-config.py).\r\n321: #\r\n322: # Doi lai phai canh bao mot lan: Web.config trong snapshot dinh cung gia tri cua moi truong\r\n323: # luc pull code (DB, IDS, Redis, URL service...), khong phai moi truong chon trong app.config.\r\n324: # apply-env-config.py copy ban goc ra Web.config.pristine ngay lan chay dau, nen khong co\r\n325: # file do = chua ai chay `make config` bao gio (hoac vua `make config ARGS=\"--restore\"`).\r\n326: # Chi canh bao, khong chan - quyet dinh la cua nguoi chay.\r\n327: if (-not (Test-Path (Join-Path $ProjectDir 'Web.config.pristine'))) {\r\n328:     Write-Warn 'chua chay `make config` lan nao - Web.config dang la gia tri goc cua snapshot, khong phai app.config o root.'\r\n329: }\r\n330: \r\n331: if ($KillPort -or $Verify) { Invoke-KillPort }\r\n332: \r\n333: if (-not $NoBuild) {\r\n334:     Write-Step 'Tim MSBuild'\r\n335:     $found = Find-MSBuild\r\n336:     if (-not $found) {\r\n337:         Die @\"\r\n338: Khong tim thay MSBuild.exe co web targets.\r\n339: Cai 'Build Tools for Visual Studio' kem workload 'ASP.NET and web development'.\r\n340: `dotnet build` KHONG build duoc project non-SDK + packages.config nay.\r\n341: \"@\r\n342:     }\r\n343:     Write-Ok $found.Path\r\n344:     Write-Ok \"WebApplication.targets: $($found.WebTargets)\"\r\n345: \r\n346:     Invoke-Restore $found.Path\r\n347:     Invoke-Build   $found.Path\r\n348: }\r\n349: \r\n350: if ($BuildOnly) { Write-Host \"`nXong (BuildOnly).\" -ForegroundColor Green; exit 0 }\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

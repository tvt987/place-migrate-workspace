imeout(180_000);\n39:   const username = getUsername();\n40:   const password = getPassword();\n41:   if (!username || !password) {\n42:     throw new Error('TEST_USERNAME and TEST_PASSWORD must be set in .env (see .env.example)');\n43:   }\n44: \n45:   const appOrigin = new URL(getBaseUrl()).origin;\n46:   await page.goto(getBaseUrl(), { waitUntil: 'domcontentloaded', timeout: 60000 });\n47: \n48:   const onLoginPage = await page\n49:     .waitForURL(\n50:       (u) =>\n51:         u.origin !== appOrigin ||\n52:         /\\/identity|\\/Account\\/Login|\\/connect\\/authorize/i.test(u.href),\n53:       { timeout: 15000 },\n54:     )\n55:     .then(() => true)\n56:     .catch(() => false);\n57: \n58:   if (onLoginPage) {\n59:     const usernameInput = page.locator('input[name=\"username\"]').first();\n60:     const passwordInput = page.locator('input[name=\"password\"]').first();\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

\r\n173:             ${networkBlock(t)}\r\n174:             ${consoleBlock(t)}\r\n175:             ${attachmentBlock(t)}\r\n176:           </div>\r\n177:         </details>`;\r\n178:         })\r\n179:         .join('\\n');\r\n180: \r\n181:       return `\r\n182:       <details class=\"endpoint ${failCls}\" data-fail=\"${rt.hasFail ? '1' : '0'}\" data-label=\"${esc(rt.route.toLowerCase())}\"${open}>\r\n183:         <summary>\r\n184:           <span class=\"ep-path\">${esc(rt.route)}</span>\r\n185:           <span class=\"badges\">\r\n186:             <span class=\"badge pass\">${rt.passed}/${rt.total} pass</span>\r\n187:             ${rt.failed ? `<span class=\"badge fail\">${rt.failed} fail</span>` : ''}\r\n188:             ${rt.skipped ? `<span class=\"badge skip\">${rt.skipped} skip</span>` : ''}\r\n189:           </span>\r\n190:         </summary>\r\n191:         <div class=\"cases\">${cases}</div>\r\n192:       </details>`;\r\n193:     })\r\n194:     .join('\\n');\r\n195: \r\n196:   return `<!DOCTYPE html>\r\n197: <html lang=\"vi\">\r\n198: <head>\r\n199: <meta charset=\"utf-8\"/>\r\n200: <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

2:     } finally {\n33:       this.page.off('response', onResp);\n34:     }\n35:   }\n36: \n37:   async search(\n38:     endpoint: string,\n39:     keyword?: string,\n40:   ): Promise<{ response: Response | null; codeStep: ObjCodeStep | null; alerted: boolean }> {\n41:     await this.page.evaluate(() => {\n42:       document.querySelectorAll('.jconfirm').forEach((e) => e.remove());\n43:     }).catch(() => {});\n44:     if (keyword != null && keyword !== '') {\n45:       const kw = this.ui.keyword();\n46:       if (await kw.count()) {\n47:         await kw.fill(keyword);\n48:       }\n49:     } else if (keyword === '') {\n50:       const kw = this.ui.keyword();\n51:       if (await kw.count()) {\n52:         await kw.fill('');\n53:       }\n54:     }\n55:     const wait = waitForPost(this.page, endpoint, 60000);\n56:     const alertP = this.ui\n57:       .alertText()\n58:       .or(this.ui.alertWarning())\n59:       .or(this.page.locator('.jconfirm, .boxNotify, .boxNotifyWarning'))\n60:       .waitFor({ state: 'visible', timeout: 12000 })\n61:       .then(() => true)\n62:       .catch(() => false);\n63:     await this.ui.searchButton().click();\n64:     const alerted = await alertP;\n65:     if (alerted) {\n66:       return { response: null, codeStep: null, alerted: true };\n67:     }\n68:     const response = await wait.catch(() => null);\n69:     return { response, codeStep: await readCodeStep(response), alerted: false };\n70:   }\n71: \n72:   async gotoPage2(endpoint: string): Promise<{ response: Response | null; codeStep: ObjCodeStep | null; alerted: boolean }> {\n73:     const wait = waitForPost(this.page, endpoint, 60000);\n74:     const link = this.ui.pagerPage2();\n75:     await link.click();\n76:     const response = await wait.catch(() => null);\n77:     return { response, codeStep: await readCodeStep(response), alerted: false };\n78:   }\n79:   async clickExportExcel(): Promise<void> {\n80:     await this.ui.exportExcelButton().click();\n81:   }\n82: }\n83
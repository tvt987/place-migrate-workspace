T) { $env:API_PORT } else { 5104 }\r\n24:     $WebPort   = if ($env:WEB_PORT) { $env:WEB_PORT } else { 5305 }\r\n25:     $ApiCsproj = if ($env:API_CSPROJ) { $env:API_CSPROJ } else { \"..\\..\\store-location-api\\02_target\\net10_mssql\\Coc.API.Place\\Coc.API.Place.csproj\" }\r\n26:     $ApiDir    = if ($env:API_DIR) { $env:API_DIR } else { \"..\\..\\store-location-api\\02_target\\net10_mssql\\Coc.API.Place\" }\r\n27:     $WebCsproj = if ($env:WEB_CSPROJ) { $env:WEB_CSPROJ } else { \"..\\02_target\\CoC.Web.Place\\CoC.Web.Place.csproj\" }\r\n28:     $WebDir    = if ($env:WEB_DIR) { $env:WEB_DIR } else { \"..\\02_target\\CoC.Web.Place\" }\r\n29: }\r\n30: \r\n31: $TempDir = $env:TEMP\r\n32: $ApiPidFile = Join-Path $TempDir \"store-location-web-api-e2e.pid\"\r\n33: $WebPidFile = Join-Path $TempDir \"store-location-web-web-e2e.pid\"\r\n34: $ApiLog = Join-Path $TempDir \"store-location-web-api-e2e.log\"\r\n35: $WebLog = Join-Path $TempDir \"store-location-web-web-e2e.log\"\r\n36: \r\n37: Write-Host \"VARIANT=$Variant API=:$ApiPort WEB=:$WebPort\"\r\n38: \r\n39: function Stop-Port($port) {\r\n40:     $conns = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue\r\n41:     foreach ($c in $conns) {\r\n42:         try {\r\n43:             Stop-Process -Id $c.OwningProcess -Force -ErrorAction SilentlyContinue\r\n44:             Write-Host \"Killed port $port (PID $($c.OwningProcess))\"\r\n45:         } catch {}\r\n46:     }\r\n47: }\r\n48: \r\n49: Stop-Port $ApiPort\r\n50: Stop-Port $WebPort\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

ontext({\r\n28:     baseURL: getBaseUrl(),\r\n29:     ignoreHTTPSErrors: true,\r\n30:     storageState: { cookies: [], origins: [] },\r\n31:   });\r\n32:   const page = await ctx.newPage();\r\n33:   return { ctx, page };\r\n34: }\r\n35: \nThe above content shows the entire, complete file contents of the requested file.\n"}

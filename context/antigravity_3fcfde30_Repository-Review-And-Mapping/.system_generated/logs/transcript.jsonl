{"step_index":10728,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-14T03:26:57Z","content":"Created At: 2026-10-14T10:26:57+07:00\nCompleted At: 2026-10-14T10:26:57+07:00\nFile Path: `file:///C:/Users/25303_TruongVanTinh/.gemini/antigravity-ide/brain/3fcfde30-4110-403c-8f9f-a4ed95abc9e6/scratch/create_dc_prs.py`\nTotal Lines: 41\nTotal Bytes: 2002\nShowing lines 1 to 41\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import subprocess, urllib.request, urllib.error, json\n2: \n3: def get_token():\n4:     p = subprocess.Popen(['git', 'credential', 'fill'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n5:     out, _ = p.communicate('protocol=https\\nhost=bitbucket.org\\n\\n')\n6:     creds = dict(l.split('=', 1) for l in out.splitlines() if '=' in l)\n7:     return creds.get('password')\n8: \n9: def create_pull_request(repo, src, dest, title, description=\"\"):\n10:     token = get_token()\n11:     url = f'https://api.bitbucket.org/2.0/repositories/{repo}/pullrequests'\n12:     payload = {\n13:         \"title\": title,\n14:         \"description\": description or f\"Merge branch '{src}' into {dest}\",\n15:         \"source\": {\"branch\": {\"name\": src}},\n16:         \"destination\": {\"branch\": {\"name\": dest}},\n17:         \"close_source_branch\": False\n18:     }\n19:     data = json.dumps(payload).encode('utf-8')\n20:     req = urllib.request.Request(url, data=data, method='POST')\n21:     req.add_header('Authorization', f'Bearer {token}')\n22:     req.add_header('Content-Type', 'application/json')\n23:     try:\n24:         with urllib.request.urlopen(req) as resp:\n25:             res_data = json.loads(resp.read().decode('utf-8'))\n26:             pr_id = res_data.get('id')\n27:             html_url = res_data.get('links', {}).get('html', {}).get('href')\n28:             print(f\"[SUCCESS] Created PR #{pr_id}: {title}\")\n29:             print(f\"  URL: {html_url}\")\n30:             return res_data\n31:     except urllib.error.HTTPError as e:\n32:         err_msg = e.read().decode('utf-8')\n33:         print(f\"[ERROR {e.code}] Failed to create PR for {src} -> {dest}: {err_msg}\")\n34:         return None\n35: \n36: if __name__ == '__main__':\n37:     repo = \"concung/cci-dc-web\"\n38:     print(\"=== Creating PRs for cci-dc-web ===\")\n39:     create_pull_request(repo, \"dev\", \"staging10\", \"Merge dev into staging10\", \"fix(qa): update pagerPage2 selector in page objects to target clickable link\")\n40:     create_pull_request(repo, \"dev\", \"staging\", \"Merge dev into staging\", \"fix(qa): update pagerPage2 selector in page objects to target clickable link\")\n41: \nThe above content shows the entire, complete file contents of the requested file.\n"}

t allure.tag('FLOW');\n57: \n58:     await mod.open(data.screen.route);\n59:     test.setTimeout(90000);\n60:     await expect(mod.ui.searchButton()).toBeVisible({ timeout: 30000 });\n61:     const res = await mod.search(data.screen.searchEndpoint);\n62:     if (res.alerted) return;\n63:     await assertSearchContract(res.response, res.codeStep, {\n64:       onPerfWarn: async (ms, url) => {\n65:         await allure.tag('PERF_WARN');\n66:         await allure.attachment('perf-warn', `${ms}ms ${url}`, 'text/plain');\n67:       },\n68:     });\n69:   });\n70: });\n71: \n72: test.describe('TC-SCM-64-003 — anonymous → SSO [AUTH]', () => {\n73:   test(`${data.auth.scenario} [AUTH]`, async ({ browser }) => {\n74:     await allure.severity('high');\n75:     await allure.story('Auth');\n76:     await allure.tag('AUTH');\n77: \n78:     const { ctx, page: anonPage } = await newAnonContext(browser);\n79:     await anonPage.goto(data.auth.input.route, { waitUntil: 'domcontentloaded', timeout: 60000 });\n80:     await expect(anonPage).toHaveURL((u) => isOnIds(u), { timeout: 30000 });\n81:     await ctx.close();\n82:   });\n83: });\n84: \n85: test.describe('TC-SCM-64-004 — toolbar / search controls [VALIDATION]', () => {\n86:   test(`${data.validation.scenario} [VALIDATION]`, async () => {\n87:     await allure.severity('normal');\n88:     await allure.story('Validation');\n89:     await allure.tag('VALIDATION');\n90: \n91:     await mod.open(data.screen.route);\n92:     await expect(mod.ui.content()).toBeVisible({ timeout: 30000 });\n93:     try {\n94:       await expect(mod.ui.searchButton()).toBeVisible({ timeout: 30000 });\n95:     } catch {\n96:       const toolbarCount = await mod.ui.toolbar().count();\n97:       expect(toolbarCount, 'expect search hoặc toolbar sau render').toBeGreaterThan(0);\n98:     }\n99:   });\n100: });\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

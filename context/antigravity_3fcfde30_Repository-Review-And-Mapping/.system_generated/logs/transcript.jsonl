  := pwsh -NoProfile -File\n25: endif\n26: \n27: ROOT_DIR := $(abspath $(CURDIR)/../../../..)\n28: PROJECTS_JSON := $(ROOT_DIR)/.meta/00_projects.json\n29: PROJECT_INFO_JSON := $(CURDIR)/01_origin/project_info\n<truncated 7172 bytes>\napshot goc 01_origin (.NET Framework 4.6.1) bang MSBuild cua Visual Studio\n166: # + IIS Express - project non-SDK + packages.config nen KHONG dung duoc dotnet build/run.\n167: # Port lay tu <runPorts app=\"origin\"> trong app.config.\n168: #   make run_origin                       # restore + build + chay foreground, TU MO trinh duyet\n169: #   make run_origin OPEN=0                # khong mo trinh duyet\n170: #   make run_origin ARGS=\"-KillPort\"      # tu dung tien trinh dang giu port\n171: #   make run_origin ARGS=\"-NoBuild\"       # bo qua restore/build\n172: #\n173: # KHONG nhan ENV: script khong bom config, do la viec rieng cua `make config`. Muon origin\n174: # chay theo moi truong nao thi `make config ENV=<ten>` truoc - appSetting.config giu nguyen\n175: # gia tri da bom cho toi lan `make config` sau, nen chi can lam mot lan.\n176: run_origin:\n177: \t@$(PWSH) \"$(CURDIR)/scripts/run-origin.ps1\" $(if $(findstring OpenBrowser,$(ARGS)),,$(OPEN_ORIGIN)) $(ARGS)\n178: \n179: # Chi restore + build 01_origin, khong chay. Ban Debug duoc ep DebugType=portable de\n180: # breakpoint bind duoc trong VS Code (xem ghi chu trong scripts/run-origin.ps1).\n181: #   make build_origin\n182: #   make build_origin ARGS=\"-Clean\"\n183: build_origin:\n184: \t@$(PWSH) \"$(CURDIR)/scripts/run-origin.ps1\" -BuildOnly $(ARGS)\n185: \n186: # Build, chay IIS Express o nen, goi trang chu, in PASS/FAIL roi tat. Exit code khac 0 khi\n187: # fail nen dung duoc trong CI. 200/301/302 deu tinh la khoe (chua dang nhap thi / redirect\n188: # sang /accounts/login).\n189: #   make verify_origin\n190: verify_origin:\n191: \t@$(PWSH) \"$(CURDIR)/scripts/run-origin.ps1\" -Verify $(ARGS)\n192: \n193: # ===== target (.NET 10) =====\n194: # Cac lenh build/run/verify/test cua target nam trong 02_target/Makefile (dotnet CLI, Kestrel).\n195: #   cd 02_target && make run       |   make verify   |   make build   |   make test\n196: # Port cua target cung lay tu <runPorts app=\"target\"> trong app.config o root.\n197: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}

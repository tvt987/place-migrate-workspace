{"step_index":18184,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-15T02:10:00Z","content":"Created At: 2026-10-15T09:10:00+07:00\nCompleted At: 2026-10-15T09:10:00+07:00\nFile Path: `file:///E:/Work/Place_Migrate/cci-scm-web/03_qa/scripts/upload-report.js`\nTotal Lines: 160\nTotal Bytes: 6277\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env node\n2: 'use strict';\n3: \n4: const path = require('path');\n5: const fs = require('fs');\n6: \n7: const PLATFORM = 'web';\n8: const GCS_PREFIX = 'test_report/WEB';\n9: const ROOT = path.join(__dirname, '..');\n10: const DETAILS_DIR = path.join(ROOT, 'reports', 'details');\n11: \n12: function fail(message) {\n13:   throw new Error(message);\n14: }\n15: \n16: function buildObjectName(project, fileName) {\n17:   return `${GCS_PREFIX}/${project}/${fileName}`;\n18: }\n19: \n20: function buildUpsertParams({ project, fileName, appEnv, testMachine, gcsUrl }) {\n21:   return [project, PLATFORM, fileName, appEnv, testMachine, gcsUrl];\n22: }\n23: \n24: function resolveFile(argv, fileSystem = fs) {\n25:   const prefixIndex = argv.indexOf('--prefix');\n26:   if (prefixIndex < 0) {\n27:     if (!argv[0]) fail('missing argument: <file.json> or --prefix <prefix>');\n28:     return path.resolve(argv[0]);\n29:   }\n30: \n31:   const prefix = argv[prefixIndex + 1];\n32:   if (!prefix) fail('--prefix requires a value');\n33:   const cleanPrefix = prefix.replace(/[^a-z0-9-]/gi, '');\n34:   const expression = new RegExp(`^${cleanPrefix}-report-\\\\d{8}-\\\\d{6}\\\\.json$`);\n35:   const files = fileSystem.existsSync(DETAILS_DIR)\n36:     ? fileSystem.readdirSync(DETAILS_DIR).filter((fileName) => expression.test(fileName))\n37:     : [];\n38:   if (!files.length) fail(`no reports/details/${prefix}-report-<timestamp>.json`);\n39:   return path.join(DETAILS_DIR, files.sort().pop());\n40: }\n41: \n42: function parseReport(file, fileSystem = fs) {\n43:   const report = JSON.parse(fileSystem.readFileSync(file, 'utf8'));\n44:   if (!report.summary) fail('report is missing summary');\n45:   if (typeof report.testMachine !== 'string' || !report.testMachine.trim()) {\n46:     fail('report has no non-empty testMachine');\n47:   }\n48:   return report;\n49: }\n50: \n51: function loadToken(fileSystem = fs) {\n52:   const tokenFile = path.join(ROOT, '.auth', 'token.json');\n53:   if (!fileSystem.existsSync(tokenFile)) fail('missing .auth/token.json; run the test setup first');\n54:   const token = JSON.parse(fileSystem.readFileSync(tokenFile, 'utf8'));\n55:   if (!token.access_token) fail('.auth/token.json is missing access_token');\n56:   if (token.expires_at && new Date(token.expires_at).getTime() <= Date.now()) {\n57:     fail(`token expired at ${token.expires_at}; run the test setup again`);\n58:   }\n59:   return token.access_token;\n60: }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

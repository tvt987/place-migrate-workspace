= require('fs');\n+\n+const PLATFORM = 'web';\n+const GCS_PREFIX = 'test_report/WEB';\n+const ROOT = path.join(__dirname, '..');\n+const DETAILS_DIR = path.join(ROOT, 'reports', 'details');\n+\n+function fail(message) {\n+  throw new Error(message);\n+}\n+\n+function buildObj\n<truncated 4045 bytes>\nLUDED.app_env,\n+                     test_machine = EXCLUDED.test_machine,\n+                     gcs_url = EXCLUDED.gcs_url,\n+                     created_at = now()\n+       RETURNING test_report_id`,\n+      buildUpsertParams(params),\n+    );\n+    return result.rows[0].test_report_id;\n+  } finally {\n+    await client.end();\n+  }\n+}\n+\n+async function main(argv = process.argv.slice(2), dependencies = {}) {\n+  const fileSystem = dependencies.fs || fs;\n+  const env = dependencies.env || process.env;\n+  const fetchImpl = dependencies.fetch || fetch;\n+  const dryRun = argv[0] === '--dry-run';\n+  const file = resolveFile(dryRun ? argv.slice(1) : argv, fileSystem);\n+  if (!fileSystem.existsSync(file)) fail(`report file not found: ${file}`);\n+  const report = parseReport(file, fileSystem);\n+  const project = env.TESTREPORTER_PROJECT || '1_MBM';\n+  const fileName = path.basename(file);\n+  const objectName = buildObjectName(project, fileName);\n+\n+  if (dryRun) {\n+    console.log(`object=${objectName} platform=${PLATFORM} testMachine=${report.testMachine}`);\n+    return;\n+  }\n+\n+  const signed = await presign(objectName, loadToken(fileSystem), env, fetchImpl);\n+  const bytes = await put(file, signed, fileSystem, fetchImpl);\n+  const createClient = dependencies.createClient || ((config) => new (require('pg').Client)(config));\n+  const testReportId = await record(\n+    { project, fileName, appEnv: report.appEnv || null, testMachine: report.testMachine, gcsUrl: signed.AbsoluteURL },\n+    env,\n+    createClient,\n+  );\n+  console.log(`uploaded ${objectName} (${bytes} bytes), test_report_id=${testReportId}`);\n+}\n+\n+module.exports = { buildObjectName, buildUpsertParams, main, parseReport, resolveFile };\n+\n+if (require.main === module) {\n+  require('dotenv').config({ path: path.join(ROOT, '.env') });\n+  main().catch((error) => {\n+    const cause = error.cause && (error.cause.code || error.cause.message);\n+    console.error(`upload-report: ${error.message || error}${cause ? `: ${cause}` : ''}`);\n+    process.exitCode = 1;\n+  });\n+}\n\n","truncated_fields":["content"]}

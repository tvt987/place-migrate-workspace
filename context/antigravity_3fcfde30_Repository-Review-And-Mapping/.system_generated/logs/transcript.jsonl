\n34: \r\n35: GCS_API = os.environ.get(\"TESTREPORTER_GCS_API\", \"https://wap-gcs-api-stg.concung.vn/api/gcs/public/getpresignedlink\")\r\n36: GCS_MODULE = os.environ.get(\"TESTREPORTER_GCS_MODULE\", \"none\")\r\n37: PROJECT = os.environ.get(\"TESTREPORTER_PROJECT\", \"11_D\n<truncated 836 bytes>\ness_token found in token.json\")\r\n58:     return token\r\n59: \r\n60: def upload_file(report_file, app_env):\r\n61:     if not os.path.exists(report_file):\r\n62:         raise RuntimeError(f\"Report file not found: {report_file}\")\r\n63:     \r\n64:     file_name = os.path.basename(report_file)\r\n65:     print(f\"--> Processing {file_name} ({PROJECT}, {app_env})...\")\r\n66:     \r\n67:     token = get_token()\r\n68:     \r\n69:     # 1. Presign\r\n70:     url = f\"{GCS_API}?fileName={file_name}&module={GCS_MODULE}\"\r\n71:     with httpx.Client(verify=False) as client:\r\n72:         res = client.get(url, headers={\"accept\": \"text/plain\", \"Authorization\": f\"Bearer {token}\"})\r\n73:         if res.status_code != 200:\r\n74:             raise RuntimeError(f\"Presign failed: {res.status_code} - {res.text}\")\r\n75:         data = res.json()\r\n76:         presigned_url = data[\"PreSignedURL\"]\r\n77:         absolute_url = data[\"AbsoluteURL\"]\r\n78:         content_type = data.get(\"ContentType\", \"application/json\")\r\n79:         \r\n80:         # 2. PUT to GCS\r\n81:         with open(report_file, \"rb\") as f:\r\n82:             file_bytes = f.read()\r\n83:         \r\n84:         put_res = client.put(presigned_url, content=file_bytes, headers={\"Content-Type\": content_type})\r\n85:         if put_res.status_code not in (200, 201):\r\n86:             raise RuntimeError(f\"GCS PUT failed: {put_res.status_code} - {put_res.text}\")\r\n87:         \r\n88:         print(f\"    Uploaded to GCS: {absolute_url} ({len(file_bytes)/1048576:.2f} MB)\")\r\n89:         \r\n90:         # 3. Record in PostgreSQL ReportTest\r\n91:         conn = psycopg2.connect(\r\n92:             host=DB_HOST,\r\n93:             database=DB_NAME,\r\n94:             user=DB_USER,\r\n95:             password=DB_PASS,\r\n96:             sslmode=\"require\"\r\n97:         )\r\n98:         try:\r\n99:             cur = conn.cursor()\r\n100:             cur.execute(\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

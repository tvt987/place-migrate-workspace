n18:         }\r\n19: \r\n20:         private sealed class SessionDto\r\n21:         {\r\n22:             public string Token { get; set; }\r\n23:             public string RefreshToken { get; set; }\r\n24:             p\n<truncated 195 bytes>\ntic void Save(ISession session, UserPrincipal user)\r\n30:         {\r\n31:             if (session == null || user == null) return;\r\n32:             var dto = new SessionDto\r\n33:             {\r\n34:                 Token = user.Token,\r\n35:                 RefreshToken = user.RefreshToken,\r\n36:                 Claims = user.Claims.Select(c => new ClaimDto { Type = c.Type, Value = c.Value }).ToList(),\r\n37:                 CFName = user.CFName,\r\n38:                 DisplayName = user.DisplayName\r\n39:             };\r\n40:             session.SetString(PrincipalKey, JsonConvert.SerializeObject(dto));\r\n41:         }\r\n42: \r\n43:         public static void Clear(ISession session)\r\n44:         {\r\n45:             session?.Remove(PrincipalKey);\r\n46:         }\r\n47: \r\n48:         public static bool Exists(ISession session)\r\n49:         {\r\n50:             try { return session != null && !string.IsNullOrEmpty(session.GetString(PrincipalKey)); }\r\n51:             catch { return false; }\r\n52:         }\r\n53: \r\n54:         public static UserPrincipal Load(ISession session)\r\n55:         {\r\n56:             string json;\r\n57:             try { json = session?.GetString(PrincipalKey); } catch { return null; }\r\n58:             if (string.IsNullOrEmpty(json)) return null;\r\n59:             try\r\n60:             {\r\n61:                 var dto = JsonConvert.DeserializeObject<SessionDto>(json);\r\n62:                 if (dto == null || dto.Claims == null) return null;\r\n63:                 var claims = dto.Claims.Select(c => new Claim(c.Type, c.Value ?? string.Empty)).ToList();\r\n64:                 var user = new UserPrincipal(dto.Token, dto.RefreshToken, claims);\r\n65:                 user.CFName = dto.CFName;\r\n66:                 user.DisplayName = dto.DisplayName;\r\n67:                 return user;\r\n68:             }\r\n69:             catch\r\n70:             {\r\n71:                 return null;\r\n72:             }\r\n73:         }\r\n74:     }\r\n75: }\r\n76: //AI[MIGRATE_END]\r\n77: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}

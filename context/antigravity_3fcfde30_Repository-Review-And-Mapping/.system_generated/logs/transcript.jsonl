inq;\r\n7: using System;\r\n8: using System.Collections.Generic;\r\n9: using System.Globalization;\r\n10: using System.IO;\r\n11: using System.Text;\r\n12: using System.Threading.Tasks;\r\n13: \r\n14\n<truncated 784 bytes>\ny.Position = 0;\r\n31:             if (string.IsNullOrWhiteSpace(body))\r\n32:                 return;\r\n33: \r\n34:             JToken token;\r\n35:             try\r\n36:             {\r\n37:                 token = JsonConvert.DeserializeObject<JToken>(body, new JsonSerializerSettings { DateParseHandling = DateParseHandling.None });\r\n38:             }\r\n39:             catch (JsonException)\r\n40:             {\r\n41:                 return;\r\n42:             }\r\n43:             if (token == null)\r\n44:                 return;\r\n45: \r\n46:             var values = new Dictionary<string, StringValues>(StringComparer.OrdinalIgnoreCase);\r\n47:             Flatten(token, string.Empty, values);\r\n48:             if (values.Count > 0)\r\n49:                 context.ValueProviders.Add(new JQueryFormValueProvider(BindingSource.Form, values, CultureInfo.InvariantCulture));\r\n50:         }\r\n51: \r\n52:         private static void Flatten(JToken token, string prefix, Dictionary<string, StringValues> values)\r\n53:         {\r\n54:             switch (token.Type)\r\n55:             {\r\n56:                 case JTokenType.Object:\r\n57:                     foreach (var property in ((JObject)token).Properties())\r\n58:                         Flatten(property.Value, prefix.Length == 0 ? property.Name : prefix + \".\" + property.Name, values);\r\n59:                     break;\r\n60:                 case JTokenType.Array:\r\n61:                     var i = 0;\r\n62:                     foreach (var item in (JArray)token)\r\n63:                         Flatten(item, prefix + \"[\" + (i++) + \"]\", values);\r\n64:                     break;\r\n65:                 case JTokenType.Null:\r\n66:                 case JTokenType.Undefined:\r\n67:                     break;\r\n68:                 default:\r\n69:                     values[prefix] = ((JValue)token).ToString(CultureInfo.InvariantCulture);\r\n70:                     break;\r\n71:             }\r\n72:         }\r\n73:     }\r\n74: }\r\n75: //AI[MIGRATE_END]\r\n76: \r\n77: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}

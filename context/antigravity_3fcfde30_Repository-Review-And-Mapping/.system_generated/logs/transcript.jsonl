)\",); status=$$?; ./scripts/stop-env.sh; exit $$status\n118: else\n119: \tLOCAL_BASE_URL=$(NET10_MSSQL_BASE_URL) BASE_URL=$(NET10_MSSQL_BASE_URL) REPORT_PREFIX=test-mssql \\\n120: \t\tnpx playwright test --project=e2e $(if $(WORKERS),--workers=$(WORKERS),) $(SPEC) $(if $(GREP),-g \"$(GREP)\",)\n121: endif\n122: \n123: test_e2e_net10_postgresql:\n124: ifeq ($(call is_local,$(NET10_POSTGRESQL_BASE_URL)),1)\n125: \tVARIANT=pgsql ./scripts/start-env.sh && LOCAL_BASE_URL=http://localhost:5305 BASE_URL=http://localhost:5305 REPORT_PREFIX=test-pgsql \\\n126: \t\tnpx playwright test --project=e2e $(if $(WORKERS),--workers=$(WORKERS),) $(SPEC) $(if $(GREP),-g \"$(GREP)\",); status=$$?; ./scripts/stop-env.sh; exit $$status\n127: else\n128: \tLOCAL_BASE_URL=$(NET10_POSTGRESQL_BASE_URL) BASE_URL=$(NET10_POSTGRESQL_BASE_URL) REPORT_PREFIX=test-pgsql \\\n129: \t\tnpx playwright test --project=e2e $(if $(WORKERS),--workers=$(WORKERS),) $(SPEC) $(if $(GREP),-g \"$(GREP)\",)\n130: endif\n131: \n132: # Smoke: mở browser THẬT (headed, không headless) trên 1 spec (home) để verify visual nhanh.\n133: # --workers=1 để chạy tuần tự, dễ quan sát trên màn hình.\n134: smoke:\n135: \t./scripts/start-env.sh && npx playwright test --project=e2e-local --headed --workers=1 e2e/home/home.e2e.spec.ts -g \"smoke:\"; status=$$?; ./scripts/stop-env.sh; exit $$status\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

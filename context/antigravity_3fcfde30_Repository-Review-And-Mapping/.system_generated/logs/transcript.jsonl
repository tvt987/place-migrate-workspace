{"step_index":13119,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-14T08:16:10Z","content":"Created At: 2026-10-14T15:16:10+07:00\nCompleted At: 2026-10-14T15:16:10+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-scm-web/03_qa/modules/gift-vouchers.module.ts`\nTotal Lines: 76\nTotal Bytes: 2524\nShowing lines 1 to 76\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { Page, Response } from '@playwright/test';\n2: import { GiftVouchersPage } from '../pages/gift-vouchers.page';\n3: import { waitForPost, readCodeStep, type ObjCodeStep } from '../utils/screen-helper';\n4: \n5: /** Flow gift-vouchers — KHÔNG assert. */\n6: export class GiftVouchersModule {\n7:   readonly ui: GiftVouchersPage;\n8: \n9:   constructor(readonly page: Page) {\n10:     this.ui = new GiftVouchersPage(page);\n11:   }\n12: \n13:   /** Place-deep: đếm POST Search trong lúc open. */\n14:   searchesDuringLoad = 0;\n15: \n16:   async open(route: string, searchEndpoint?: string): Promise<Response | null> {\n17:     this.searchesDuringLoad = 0;\n18:     const ep = (searchEndpoint || '').toLowerCase();\n19:     const onResp = (r: Response) => {\n20:       if (ep && r.request().method() === 'POST' && r.url().toLowerCase().includes(ep)) {\n21:         this.searchesDuringLoad += 1;\n22:       }\n23:     };\n24:     this.page.on('response', onResp);\n25:     try {\n26:       const resp = await this.ui.goto(route);\n27:       await this.page.waitForTimeout(1500);\n28:       return resp;\n29:     } finally {\n30:       this.page.off('response', onResp);\n31:     }\n32:   }\n33: \n34:   async search(\n35:     endpoint: string,\n36:     keyword?: string,\n37:   ): Promise<{ response: Response | null; codeStep: ObjCodeStep | null; alerted: boolean }> {\n38:     if (keyword != null && keyword !== '') {\n39:       const kw = this.ui.keyword();\n40:       if (await kw.count()) {\n41:         await kw.fill(keyword);\n42:       }\n43:     } else if (keyword === '') {\n44:       const kw = this.ui.keyword();\n45:       if (await kw.count()) {\n46:         await kw.fill('');\n47:       }\n48:     }\n49:     const wait = waitForPost(this.page, endpoint, 60000);\n50:     const alertP = this.ui\n51:       .alertText()\n52:       .or(this.ui.alertWarning())\n53:       .waitFor({ state: 'visible', timeout: 12000 })\n54:       .then(() => true)\n55:       .catch(() => false);\n56:     await this.ui.searchButton().click();\n57:     const alerted = await alertP;\n58:     if (alerted) {\n59:       return { response: null, codeStep: null, alerted: true };\n60:     }\n61:     const response = await wait.catch(() => null);\n62:     return { response, codeStep: await readCodeStep(response), alerted: false };\n63:   }\n64: \n65:   async gotoPage2(endpoint: string): Promise<{ response: Response | null; codeStep: ObjCodeStep | null; alerted: boolean }> {\n66:     const wait = waitForPost(this.page, endpoint, 60000);\n67:     const link = this.ui.pagerPage2();\n68:     await link.click();\n69:     const response = await wait.catch(() => null);\n70:     return { response, codeStep: await readCodeStep(response), alerted: false };\n71:   }\n72:   async clickExportExcel(): Promise<void> {\n73:     await this.ui.exportExcelButton().click();\n74:   }\n75: }\n76: \nThe above content shows the entire, complete file contents of the requested file.\n"}

{"step_index":5073,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-05T07:03:09Z","content":"Created At: 2026-10-05T14:03:09+07:00\nCompleted At: 2026-10-05T14:03:09+07:00\nFile Path: `file:///E:/Work/Place_Migrate/cci-dc-web/03_qa/scripts/run-e2e.win.ps1`\nTotal Lines: 104\nTotal Bytes: 4758\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: # run-e2e.win.ps1 — Windows E2E orchestrator, called by Makefile.win.\r\n2: # Wraps start-env.win.ps1 / stop-env.win.ps1 + `npx playwright test` and\r\n3: # always propagates the Playwright exit code, even if the env needs stopping.\r\n4: #\r\n5: # Examples:\r\n6: #   pwsh scripts/run-e2e.win.ps1 -Variant mssql -Project e2e\r\n7: #   pwsh scripts/run-e2e.win.ps1 -Variant pgsql -Project e2e -Spec e2e/login/login.e2e.spec.ts\r\n8: #   pwsh scripts/run-e2e.win.ps1 -Variant none -Project e2e -BaseUrl https://dc-stg4.concung.vn/ -Username 2741 -Password ConcungIT123 -Grep TC-DC-19\r\n9: #   pwsh scripts/run-e2e.win.ps1 -Variant mssql -Project e2e-local -Headed -Workers 1 -Spec e2e/home/home.e2e.spec.ts -Grep \"smoke:\"\r\n10: \r\n11: param(\r\n12:     [ValidateSet(\"mssql\", \"pgsql\", \"none\", \"auto\")]\r\n13:     [string]$Variant = \"mssql\",\r\n14:     [string]$Project = \"e2e\",\r\n15:     [string]$Spec = \"\",\r\n16:     [string]$Grep = \"\",\r\n17:     [string]$Workers = \"\",\r\n18:     [switch]$Headed,\r\n19:     [string]$SlowMo = \"\",\r\n20:     [string]$BaseUrl = \"\",\r\n21:     [string]$Username = \"\",\r\n22:     [string]$Password = \"\",\r\n23:     [string]$ReportPrefix = \"\",\r\n24:     # -Variant auto: tên biến trong .env chứa URL đích (NET10_MSSQL_BASE_URL / NET10_POSTGRESQL_BASE_URL)\r\n25:     # + variant dựng local khi URL rỗng/localhost (mssql / pgsql).\r\n26:     [string]$UrlVar = \"NET10_MSSQL_BASE_URL\",\r\n27:     [ValidateSet(\"mssql\", \"pgsql\")]\r\n28:     [string]$LocalVariant = \"mssql\"\r\n29: )\r\n30: \r\n31: $ErrorActionPreference = \"Stop\"\r\n32: $scriptDir = Split-Path -Parent $MyInvocation.MyCommand.Path\r\n33: \r\n34: function Get-EnvValue([string]$key) {\r\n35:     $envFile = Join-Path $scriptDir \"..\\.env\"\r\n36:     if (-not (Test-Path $envFile)) { return \"\" }\r\n37:     $line = Get-Content $envFile | Where-Object { $_ -match \"^$key=\" } | Select-Object -First 1\r\n38:     if (-not $line) { return \"\" }\r\n39:     # Cắt \"/\" cuối (giống dc-api Makefile) — spec nối BASE + \"/...\" sẽ thành \"//\".\r\n40:     return ($line -replace \"^$key=\", \"\").Trim().TrimEnd('/')\r\n41: }\r\n42: \r\n43: # -Variant auto: biến $UrlVar trong .env (cùng tên với dc-api/03_qa/.env) quyết định local hay\r\n44: # remote — đổi đích test bằng cách sửa .env, KHÔNG cần đổi lệnh gõ. Rỗng/thiếu hoặc trỏ localhost\r\n45: # -> tự build+start API+WEB ($LocalVariant) trên máy, test ở :5311. URL remote -> trỏ thẳng, không\r\n46: # start gì cục bộ.\r\n47: if ($Variant -eq \"auto\") {\r\n48:     if ($BaseUrl -eq \"\") { $BaseUrl = Get-EnvValue $UrlVar }\r\n49:     if ($BaseUrl -ne \"\" -and $BaseUrl -notmatch '^https?://(localhost|127\\.0\\.0\\.1)(:|/|$)') {\r\n50:         $Variant = \"none\"\r\n51:     } else {\r\n52:         $BaseUrl = \"\"\r\n53:         $Variant = $LocalVariant\r\n54:     }\r\n55: }\r\n56: \r\n57: $ports = @{ mssql = 5311; pgsql = 5311 }\r\n58: \r\n59: if ($Variant -ne \"none\") {\r\n60:     & powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path $scriptDir \"start-env.win.ps1\") -Variant $Variant\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

{"step_index":4649,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-02T03:42:08Z","content":"Created At: 2026-10-02T10:42:08+07:00\nCompleted At: 2026-10-02T10:42:08+07:00\nFile Path: `file:///e:/Work/dev-ops/vaults-gitops/scripts/jsonc-to-json.py`\nTotal Lines: 73\nTotal Bytes: 1777\nShowing lines 1 to 73\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\r\n2: import json\r\n3: import sys\r\n4: from pathlib import Path\r\n5: \r\n6: \r\n7: def strip_json_comments(text: str) -> str:\r\n8:     out = []\r\n9:     i = 0\r\n10:     in_string = False\r\n11:     escaped = False\r\n12: \r\n13:     while i < len(text):\r\n14:         ch = text[i]\r\n15:         nxt = text[i + 1] if i + 1 < len(text) else \"\"\r\n16: \r\n17:         if in_string:\r\n18:             out.append(ch)\r\n19:             if escaped:\r\n20:                 escaped = False\r\n21:             elif ch == \"\\\\\":\r\n22:                 escaped = True\r\n23:             elif ch == '\"':\r\n24:                 in_string = False\r\n25:             i += 1\r\n26:             continue\r\n27: \r\n28:         if ch == '\"':\r\n29:             in_string = True\r\n30:             out.append(ch)\r\n31:             i += 1\r\n32:             continue\r\n33: \r\n34:         if ch == \"/\" and nxt == \"/\":\r\n35:             i += 2\r\n36:             while i < len(text) and text[i] not in \"\\r\\n\":\r\n37:                 i += 1\r\n38:             continue\r\n39: \r\n40:         if ch == \"/\" and nxt == \"*\":\r\n41:             i += 2\r\n42:             while i + 1 < len(text) and not (text[i] == \"*\" and text[i + 1] == \"/\"):\r\n43:                 out.append(\"\\n\" if text[i] in \"\\r\\n\" else \" \")\r\n44:                 i += 1\r\n45:             i += 2\r\n46:             continue\r\n47: \r\n48:         out.append(ch)\r\n49:         i += 1\r\n50: \r\n51:     return \"\".join(out)\r\n52: \r\n53: \r\n54: def main() -> int:\r\n55:     if len(sys.argv) != 2:\r\n56:         print(\"Usage: scripts/jsonc-to-json.py <json-file>\", file=sys.stderr)\r\n57:         return 2\r\n58: \r\n59:     source = Path(sys.argv[1])\r\n60:     try:\r\n61:         data = json.loads(strip_json_comments(source.read_text(encoding=\"utf-8-sig\")))\r\n62:     except Exception as exc:\r\n63:         print(f\"Invalid JSON: {source}: {exc}\", file=sys.stderr)\r\n64:         return 1\r\n65: \r\n66:     json.dump(data, sys.stdout, ensure_ascii=False, indent=2)\r\n67:     sys.stdout.write(\"\\n\")\r\n68:     return 0\r\n69: \r\n70: \r\n71: if __name__ == \"__main__\":\r\n72:     raise SystemExit(main())\r\n73: \nThe above content shows the entire, complete file contents of the requested file.\n"}

bsoluteURL\\\"]\\n        content_type = data.get(\\\"ContentType\\\", \\\"application/json\\\")\\n        \\n        # 2. PUT to GCS\\n        with open(report_file, \\\"rb\\\") as f:\\n            file_bytes = f.read()\\n        \\n        put_res = client.put(presigned_url, content=file_bytes, headers={\\\"Content-Type\\\": content_type})\\n        if put_res.status_code not in (200, 201):\\n  \n<truncated 1778 bytes>","Description":"\"Script upload report to GCS and PostgreSQL ReportTest for cci-dc-web\"","Overwrite":"true","TargetFile":"\"e:\\\\Work\\\\Place_Migrate\\\\cci-dc-web\\\\03_qa\\\\scripts\\\\upload_to_portal.py\"","toolAction":"\"Creating upload_to_portal.py for cci-dc-web\"","toolSummary":"\"Create upload_to_portal.py\""}}],"truncated_fields":["tool_calls"]}

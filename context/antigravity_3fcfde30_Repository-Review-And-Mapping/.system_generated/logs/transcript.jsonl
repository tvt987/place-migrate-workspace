fig root + `make config` de bom tu mot cho (go 2026-10-07).\n133: \n134: # Xem bang port cua origin/target (doc tu Properties/launchSettings.json) kem trang thai dang chay.\n135: #   make ports\n136: por\n<truncated 28 bytes>\n)/scripts/vscode-ports.ps1\"\n138: \n139: # Build + chay snapshot goc 01_origin (.NET Framework 4.8) bang MSBuild cua Visual Studio\n140: # + IIS Express - project non-SDK + packages.config nen KHONG dung duoc dotnet build/run.\n141: # Port lay tu profile \"origin\" trong Properties/launchSettings.json.\n142: #   make run_origin                       # restore + build + chay foreground, TU MO trinh duyet\n143: #   make run_origin OPEN=0                # khong mo trinh duyet\n144: #   make run_origin ARGS=\"-KillPort\"      # tu dung tien trinh dang giu port\n145: #   make run_origin ARGS=\"-NoBuild\"       # bo qua restore/build\n146: #\n147: # Gia tri moi truong sua thang trong appSetting.config - khong con co che `make config`.\n148: run_origin:\n149: \t@$(PWSH) \"$(CURDIR)/scripts/run-origin.ps1\" $(if $(findstring OpenBrowser,$(ARGS)),,$(OPEN_ORIGIN)) $(ARGS)\n150: \n151: # Chi restore + build 01_origin, khong chay. Ban Debug duoc ep DebugType=portable de\n152: # breakpoint bind duoc trong VS Code (xem ghi chu trong scripts/run-origin.ps1).\n153: #   make build_origin\n154: #   make build_origin ARGS=\"-Clean\"\n155: build_origin:\n156: \t@$(PWSH) \"$(CURDIR)/scripts/run-origin.ps1\" -BuildOnly $(ARGS)\n157: \n158: # Build, chay IIS Express o nen, goi trang chu, in PASS/FAIL roi tat. Exit code khac 0 khi\n159: # fail nen dung duoc trong CI. 200/301/302 deu tinh la khoe (chua dang nhap thi / redirect\n160: # sang /accounts/login).\n161: #   make verify_origin\n162: verify_origin:\n163: \t@$(PWSH) \"$(CURDIR)/scripts/run-origin.ps1\" -Verify $(ARGS)\n164: \n165: # ===== target (.NET 10) =====\n166: # Cac lenh build/run/verify/test cua target nam trong 02_target/Makefile (dotnet CLI, Kestrel).\n167: #   cd 02_target && make run       |   make verify   |   make build   |   make test\n168: # Port cua target cung lay tu profile \"target\" trong Properties/launchSettings.json.\n169: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

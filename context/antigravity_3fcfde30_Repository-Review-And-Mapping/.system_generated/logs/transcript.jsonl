ssword -ne \"\") { $env:TEST_PASSWORD = $Password }\r\n86: if ($SlowMo -ne \"\") { $env:SLOWMO = $SlowMo }\r\n87: if ($ReportPrefix -ne \"\") { $env:REPORT_PREFIX = $ReportPrefix }\r\n88: \r\n89: $pwArgs = @(\"playwright\", \"test\", \"--project=$Project\")\r\n90: if ($Headed) { $pwArgs += \"--headed\" }\r\n91: if ($Workers -ne \"\") { $pwArgs += \"--workers=$Workers\" }\r\n92: if ($Spec -ne \"\") { $pwArgs += $Spec }\r\n93: if ($Grep -ne \"\") { $pwArgs += @(\"-g\", $Grep) }\r\n94: \r\n95: Write-Host \"npx $($pwArgs -join ' ')\"\r\n96: & npx @pwArgs\r\n97: $testExit = $LASTEXITCODE\r\n98: \r\n99: if ($Variant -ne \"none\") {\r\n100:     & powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path $scriptDir \"stop-env.win.ps1\")\r\n101: }\r\n102: \r\n103: exit $testExit\r\n104: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

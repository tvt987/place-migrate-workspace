csproj\n29: SLN         := CoC.Web.DC.sln\n30: # Port = app.config <runPorts app=\"target\"> (5311)\n31: PORT        ?= 5311\n32: HEALTH_PATH ?= /\n33: # Prefer bare `dotnet` on PATH (avoids \"/c/Program Files/...\"\n<truncated 1701 bytes>\n\" != \"0\" ]; then { sleep $(OPEN_DELAY); $(OPEN_URL); } >/dev/null 2>&1 & fi; \\\n80: \tASPNETCORE_URLS=http://+:$(PORT) ASPNETCORE_ENVIRONMENT=Development $(DOTNET) run --project $(CSPROJ) --no-launch-profile\n81: \n82: watch: kill-port\n83: \t@if [ \"$(OPEN)\" != \"0\" ]; then { sleep $(OPEN_DELAY); $(OPEN_URL); } >/dev/null 2>&1 & fi; \\\n84: \tASPNETCORE_URLS=http://+:$(PORT) ASPNETCORE_ENVIRONMENT=Development $(DOTNET) watch run --project $(CSPROJ) --no-launch-profile\n85: \n86: clean:\n87: \t$(DOTNET) clean $(CSPROJ)\n88: \n89: start: kill-port build run\n90: dev: kill-port restore build run\n91: \n92: # 200/301/302 = healthy (auth redirect OK). Use 127.0.0.1 for Windows curl reliability.\n93: verify: kill-port build\n94: \t@echo \"Starting $(PROJECT_DIR) in background for verification (port $(PORT))...\"\n95: \t@ASPNETCORE_URLS=http://+:$(PORT) ASPNETCORE_ENVIRONMENT=Development nohup $(DOTNET) run --project $(CSPROJ) --no-launch-profile > $(VERIFY_LOG) 2>&1 & echo $$! > $(VERIFY_PID)\n96: \t@echo \"Waiting for the app to start listening on port $(PORT)...\"\n97: \t@ATTEMPTS=0; \\\n98: \tuntil curl -s -o /dev/null -w \"%{http_code}\" http://127.0.0.1:$(PORT)$(HEALTH_PATH) 2>/dev/null | grep -qE '^(200|301|302)$$'; do \\\n99: \t\tATTEMPTS=$$((ATTEMPTS+1)); \\\n100: \t\tif [ $$ATTEMPTS -ge 45 ]; then \\\n101: \t\t\techo \"\"; echo \"FAILED: app did not respond on port $(PORT) within 45s.\"; \\\n102: \t\t\ttail -n 50 $(VERIFY_LOG) 2>/dev/null || true; \\\n103: \t\t\tkill -9 $$(cat $(VERIFY_PID)) 2>/dev/null || true; $(KILL_BY_PORT); rm -f $(VERIFY_PID); exit 1; \\\n104: \t\tfi; \\\n105: \t\tsleep 1; \\\n106: \tdone; \\\n107: \tSTATUS=$$(curl -s -o /dev/null -w \"%{http_code}\" http://127.0.0.1:$(PORT)$(HEALTH_PATH)); \\\n108: \techo \"VERIFY PASSED: $(HEALTH_PATH) responded with HTTP $$STATUS\"; \\\n109: \tkill -9 $$(cat $(VERIFY_PID)) 2>/dev/null || true; $(KILL_BY_PORT); rm -f $(VERIFY_PID) $(VERIFY_LOG); \\\n110: \techo \"Done.\"\n111: \n112: test:\n113: \t@echo \"Running tests...\"\n114: \t@bash tests/scripts/run-tests.sh\n115: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}

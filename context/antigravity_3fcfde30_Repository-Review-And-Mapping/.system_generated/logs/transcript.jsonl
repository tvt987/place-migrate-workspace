{"step_index":3313,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-01T03:40:08Z","content":"Created At: 2026-10-01T10:40:08+07:00\nCompleted At: 2026-10-01T10:40:08+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-store-location-api/03_qa/scripts/upload-report.js`\nTotal Lines: 156\nTotal Bytes: 7311\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env node\r\n2: /**\r\n3:  * Đẩy report JSON chi tiết lên GCS rồi ghi 1 dòng vào ReportTest.public.test_report —\r\n4:  * portal tập trung đọc bảng này để xem report của mọi project.\r\n5:  *\r\n6:  *   1. GET  <TESTREPORTER_GCS_API>?fileName=<tên file>&module=<module>  (Bearer = token lúc test,\r\n7:  *      .auth/token.json) → { PreSignedURL, AbsoluteURL, ContentType }\r\n8:  *   2. PUT  file lên PreSignedURL — header Content-Type phải đúng ContentType trả về\r\n9:  *      (URL ký kèm `content-type;host`, lệch 1 ký tự là GCS trả 403 SignatureDoesNotMatch)\r\n10:  *   3. Upsert test_report(project, file_name, app_env, gcs_url) — khoá unique (project, file_name),\r\n11:  *      upload lại cùng file thì cập nhật gcs_url, không sinh dòng trùng.\r\n12:  *\r\n13:  * Usage:\r\n14:  *   node scripts/upload-report.js --prefix test-net10-mssql     # file <prefix>-report-<ts>.json mới nhất\r\n15:  *   node scripts/upload-report.js reports/details/test-net4-mssql-report-20260924-032726.json\r\n16:  *\r\n17:  * Chạy bằng `node --use-system-ca` (Makefile đã gắn): mạng nội bộ chặn TLS bằng CA công ty, chỉ có\r\n18:  * trong Windows cert store — không có cờ này fetch báo UNABLE_TO_VERIFY_LEAF_SIGNATURE.\r\n19:  *\r\n20:  * Env (.env): TESTREPORTER_DB_HOST/NAME/USER/PASSWORD (bắt buộc), TESTREPORTER_DB_PORT (5432),\r\n21:  *   TESTREPORTER_DB_SSL (mặc định bật, =disable để tắt),\r\n22:  *   TESTREPORTER_PROJECT (4_STORE-LOCATION), TESTREPORTER_GCS_API, TESTREPORTER_GCS_MODULE (\n<truncated 9 bytes>\n3:  */\r\n24: 'use strict';\r\n25: \r\n26: require('dotenv').config({ path: require('path').join(__dirname, '..', '.env') });\r\n27: const fs = require('fs');\r\n28: const path = require('path');\r\n29: const { Client } = require('pg');\r\n30: \r\n31: const ROOT = path.join(__dirname, '..');\r\n32: const DETAILS_DIR = path.join(ROOT, 'reports', 'details');\r\n33: const GCS_API =\r\n34:   process.env.TESTREPORTER_GCS_API ||\r\n35:   'https://wap-gcs-api-stg.concung.vn/api/gcs/public/getpresignedlink';\r\n36: const GCS_MODULE = process.env.TESTREPORTER_GCS_MODULE || 'none';\r\n37: const PROJECT = process.env.TESTREPORTER_PROJECT || '4_STORE-LOCATION';\r\n38: \r\n39: // Throw thay vì process.exit: exit ngay khi socket pg/fetch đang đóng làm libuv assert trên Windows.\r\n40: function fail(msg) {\r\n41:   throw new Error(msg);\r\n42: }\r\n43: \r\n44: /** File được chọn: đường dẫn truyền vào, hoặc <prefix>-report-<ts>.json mới nhất (bỏ qua -latest). */\r\n45: function resolveFile(argv) {\r\n46:   const i = argv.indexOf('--prefix');\r\n47:   if (i < 0) {\r\n48:     if (!argv[0]) fail('thiếu tham số: <file.json> hoặc --prefix <prefix>');\r\n49:     return path.resolve(argv[0]);\r\n50:   }\r\n51:   const prefix = argv[i + 1];\r\n52:   if (!prefix) fail('--prefix cần giá trị (vd test-net10-mssql)');\r\n53:   const re = new RegExp(`^${prefix.replace(/[^a-z0-9-]/gi, '')}-report-\\\\d{8}-\\\\d{6}\\\\.json$`);\r\n54:   const files = fs.existsSync(DETAILS_DIR) ? fs.readdirSync(DETAILS_DIR).filter((f) => re.test(f)) : [];\r\n55:   if (!files.length) fail(`không có reports/details/${prefix}-report-<ts>.json`);\r\n56:   // Tên chứa timestamp YYYYMMDD-HHMMSS → sort chuỗi = sort thời gian.\r\n57:   return path.join(DETAILS_DIR, files.sort().pop());\r\n58: }\r\n59: \r\n60: /** APP_ENV lấy từ chính report (json-reporter ghi field appEnv) — không đoán từ tên file. */\r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}

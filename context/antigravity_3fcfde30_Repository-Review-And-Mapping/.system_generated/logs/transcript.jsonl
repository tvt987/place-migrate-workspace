{"step_index":3796,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-01T08:25:43Z","content":"Created At: 2026-10-01T15:25:43+07:00\nCompleted At: 2026-10-01T15:25:43+07:00\nFile Path: `file:///e:/Work/Place_Migrate/cci-store-location-web/03_qa/scripts/upload_to_portal.py`\nTotal Lines: 101\nTotal Bytes: 3796\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env python3\r\n2: import json\r\n3: import os\r\n4: import sys\r\n5: import httpx\r\n6: import psycopg2\r\n7: \r\n8: ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\n9: DETAILS_DIR = os.path.join(ROOT, \"reports\", \"details\")\r\n10: AUTH_TOKEN_FILE = os.path.join(ROOT, \".auth\", \"token.json\")\r\n11: \r\n12: GCS_API = \"https://wap-gcs-api-stg.concung.vn/api/gcs/public/getpresignedlink\"\r\n13: GCS_MODULE = \"none\"\r\n14: PROJECT = \"4_STORE-LOCATION\"\r\n15: \r\n16: DB_HOST = \"192.168.13.223\"\r\n17: DB_NAME = \"ReportTest\"\r\n18: DB_USER = \"pnhlong\"\r\n19: DB_PASS = \"Llcoc$12#@abC!*\"\r\n20: \r\n21: def get_token():\r\n22:     if not os.path.exists(AUTH_TOKEN_FILE):\r\n23:         raise RuntimeError(f\"Missing {AUTH_TOKEN_FILE}\")\r\n24:     with open(AUTH_TOKEN_FILE, \"r\", encoding=\"utf-8\") as f:\r\n25:         data = json.load(f)\r\n26:     token = data.get(\"access_token\")\r\n27:     if not token:\r\n28:         raise RuntimeError(\"No access_token found in token.json\")\r\n29:     return token\r\n30: \r\n31: def upload_file(report_file, app_env):\r\n32:     if not os.path.exists(report_file):\r\n33:         raise RuntimeError(f\"Report file not found: {report_file}\")\r\n34:     \r\n35:     file_name = os.path.basename(report_file)\r\n36:     print(f\"--> Processing {file_name} ({PROJECT}, {app_env})...\")\r\n37:     \r\n38:     token = get_token()\r\n39:     \r\n40:     # 1. Presign\r\n41:     url = f\"{GCS_API}?fileName={file_name}&module={GCS_MODULE}\"\r\n42:     with httpx.Client(verify=False) as client:\r\n43:         res = client.get(url, headers={\"accept\": \"text/plain\", \"Authorization\": f\"Bearer {token}\"})\r\n44:         if res.status_code != 200:\r\n45:             raise RuntimeError(f\"Presign failed: {res.status_code} - {res.text}\")\r\n46:         data = res.json()\r\n47:         presigned_url = data[\"PreSignedURL\"]\r\n48:         absolute_url = data[\"AbsoluteURL\"]\r\n49:         content_type = data.get(\"ContentType\", \"application/json\")\r\n50:         \r\n51:         # 2. PUT to GCS\r\n52:         with open(report_file, \"rb\") as f:\r\n53:             file_bytes = f.read()\r\n54:         \r\n55:         put_res = client.put(presigned_url, content=file_bytes, headers={\"Content-Type\": content_type})\r\n56:         if put_res.status_code not in (200, 201):\r\n57:             raise RuntimeError(f\"GCS PUT failed: {put_res.status_code} - {put_res.text}\")\r\n58:         \r\n59:         print(f\"    Uploaded to GCS: {absolute_url} ({len(file_bytes)/1048576:.2f} MB)\")\r\n60:         \r\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

{"step_index":4647,"source":"MODEL","type":"VIEW_FILE","status":"DONE","created_at":"2026-10-02T03:42:05Z","content":"Created At: 2026-10-02T10:42:05+07:00\nCompleted At: 2026-10-02T10:42:05+07:00\nFile Path: `file:///e:/Work/dev-ops/vaults-gitops/scripts/00-validate-json.sh`\nTotal Lines: 124\nTotal Bytes: 3386\nShowing lines 1 to 124\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: #!/usr/bin/env bash\r\n2: set -euo pipefail\r\n3: \r\n4: CHANGED_FILE_LIST=\"${1:-}\"\r\n5: VAULT_TREE_ROOT=\"${VAULT_TREE_ROOT:-beta}\"\r\n6: \r\n7: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\r\n8: REPO_ROOT=\"$(cd \"${SCRIPT_DIR}/..\" && pwd)\"\r\n9: \r\n10: usage() {\r\n11:   cat <<USAGE\r\n12: Usage:\r\n13:   scripts/00-validate-json.sh <changed-file-list>\r\n14: \r\n15: Examples:\r\n16:   git diff --name-only HEAD~1 HEAD -- \"${VAULT_TREE_ROOT}/**\" > /tmp/changed.txt\r\n17:   scripts/00-validate-json.sh /tmp/changed.txt\r\n18: \r\n19: This validates changed Vault JSON files before push:\r\n20:   configs/appsettings.json or appsettings.json\r\n21:   configs/cci.core.json or cci.core.json\r\n22:   vault-payload.json\r\n23: \r\n24: It also checks that changed service folders have both:\r\n25:   configs/appsettings.json or appsettings.json\r\n26:   configs/cci.core.json or cci.core.json\r\n27: USAGE\r\n28: }\r\n29: \r\n30: service_dir_for_file() {\r\n31:   local changed_file=\"$1\"\r\n32:   local dir\r\n33: \r\n34:   dir=\"$(dirname \"${changed_file}\")\"\r\n35:   if [[ \"$(basename \"${dir}\")\" == \"configs\" ]]; then\r\n36:     dirname \"${dir}\"\r\n37:   else\r\n38:     printf '%s\\n' \"${dir}\"\r\n39:   fi\r\n40: }\r\n41: \r\n42: config_file_for_service() {\r\n43:   local service_dir=\"$1\"\r\n44:   local file_name=\"$2\"\r\n45: \r\n46:   if [[ -f \"${REPO_ROOT}/${service_dir}/configs/${file_name}\" ]]; then\r\n47:     printf '%s\\n' \"${REPO_ROOT}/${service_dir}/configs/${file_name}\"\r\n48:   else\r\n49:     printf '%s\\n' \"${REPO_ROOT}/${service_dir}/${file_name}\"\r\n50:   fi\r\n51: }\r\n52: \r\n53: if [[ -z \"${CHANGED_FILE_LIST}\" || \"${CHANGED_FILE_LIST}\" == \"-h\" || \"${CHAN\n<truncated 342 bytes>\nst.\" >&2\r\n65:   exit 1\r\n66: }\r\n67: \r\n68: tmp_service_dirs=\"$(mktemp)\"\r\n69: trap 'rm -f \"${tmp_service_dirs}\"' EXIT\r\n70: \r\n71: validated_count=0\r\n72: \r\n73: while IFS= read -r changed_file || [[ -n \"${changed_file}\" ]]; do\r\n74:   changed_file=\"${changed_file#./}\"\r\n75: \r\n76:   if [[ \"${changed_file}\" != \"${VAULT_TREE_ROOT}/\"* ]]; then\r\n77:     continue\r\n78:   fi\r\n79: \r\n80:   case \"${changed_file}\" in\r\n81:     */configs/appsettings.json|*/configs/cci.core.json) ;;\r\n82:     *) continue ;;\r\n83:   esac\r\n84: \r\n85:   full_path=\"${REPO_ROOT}/${changed_file}\"\r\n86:   if [[ ! -f \"${full_path}\" ]]; then\r\n87:     echo \"Skipping deleted file: ${changed_file}\"\r\n88:     continue\r\n89:   fi\r\n90: \r\n91:   if ! json_error=\"$(python3 \"${SCRIPT_DIR}/jsonc-to-json.py\" \"${full_path}\" 2>&1 >/dev/null)\"; then\r\n92:     echo \"Invalid JSON: ${changed_file}\" >&2\r\n93:     echo \"${json_error}\" >&2\r\n94:     exit 1\r\n95:   fi\r\n96: \r\n97:   echo \"Valid JSON: ${changed_file}\"\r\n98:   validated_count=$((validated_count + 1))\r\n99: \r\n100:   service_dir_for_file \"${changed_file}\" >> \"${tmp_service_dirs}\"\r\n101: done < \"${CHANGED_FILE_LIST}\"\r\n102: \r\n103: if [[ -s \"${tmp_service_dirs}\" ]]; then\r\n104:   sort -u \"${tmp_service_dirs}\" -o \"${tmp_service_dirs}\"\r\n105: \r\n106:   while IFS= read -r service_dir; do\r\n107:     appsettings_file=\"$(config_file_for_service \"${service_dir}\" \"appsettings.json\")\"\r\n108:     cci_core_file=\"$(config_file_for_service \"${service_dir}\" \"cci.core.json\")\"\r\n109: \r\n110:     if [[ ! -f \"${appsettings_file}\" ]]; then\r\n111:       echo \"Missing ${service_dir}/configs/appsettings.json or ${service_dir}/appsettings.json\" >&2\r\n112:       exit 1\r\n113:     fi\r\n114: \r\n115:     if [[ ! -f \"${cci_core_file}\" ]]; then\r\n116:       echo \"Missing ${service_dir}/configs/cci.core.json or ${service_dir}/cci.core.json\" >&2\r\n117:       exit 1\r\n118:     fi\r\n119:   done < \"${tmp_service_dirs}\"\r\n120: fi\r\n121: \r\n122: echo\r\n123: echo \"Validated JSON files: ${validated_count}\"\r\n124: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
